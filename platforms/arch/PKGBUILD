# Maintainer: Agustin Monetti <agmonetti@github>
pkgname=fplogin-git
pkgver=1.0.0.r268.bd735d0
pkgrel=1
pkgdesc="Biometric Fingerprint Authentication Suite for Linux Display Managers"
arch=('x86_64' 'aarch64')
url="https://github.com/agmonetti/fplogin"
license=('MIT')
depends=('glibc' 'systemd' 'fprintd')
makedepends=('go')
options=('emptydirs')
optdepends=(
    'sddm-fplogin: patched SDDM, fingerprint PAM service and base theme'
)
provides=('fplogin')
conflicts=('fplogin')
_commit=bd735d0c1119d074f51dc72b9c37f4c9a0b4a611
# Stage with git archive --format=tar --prefix=fplogin/ at this exact revision.
source=("fplogin-${_commit}.tar")
sha256sums=('51aca2cf1e589d0ad876e7f017f11cb2c32be5c79b98351792430522885748b3')

build() {
    cd "${srcdir}/fplogin"
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external"

    make build
}

check() {
    cd "${srcdir}/fplogin"
    make test
}

package() {
    cd "${srcdir}/fplogin"

    # 1. Authoritative Core Binary
    install -Dm755 bin/fplogin "${pkgdir}/usr/bin/fplogin"
    install -Dm644 platforms/arch/fplogin.sysusers "${pkgdir}/usr/lib/sysusers.d/fplogin.conf"

    local components="${pkgdir}/usr/lib/fplogin"
    install -Dm755 bin/fplogin-platform-arch "${components}/platforms/bin/fplogin-platform-arch"
    install -Dm755 bin/fplogin-adapter-sddm "${components}/adapters/bin/fplogin-adapter-sddm"
    install -Dm644 platforms/arch/platform.json "${components}/platforms/arch.json"
    install -Dm644 adapters/sddm/adapter.json "${components}/adapters/sddm.json"

    # Required descriptor directories and canonical root-owned state/drop-in dirs;
    # the SDDM payload belongs to sddm-fplogin.
    install -dm755 "${components}/platforms/assets" "${components}/adapters/assets"
    install -dm700 "${pkgdir}/var/lib/fplogin"
    install -dm755 "${pkgdir}/etc/sddm.conf.d"

    # License, Documentation, and Emergency Recovery Runbook
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 docs/EMERGENCY_RECOVERY.md "${pkgdir}/usr/share/doc/fplogin/EMERGENCY_RECOVERY.md"
    install -Dm644 docs/SUPPORTED_VERSIONS.md "${pkgdir}/usr/share/doc/fplogin/SUPPORTED_VERSIONS.md"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/fplogin/README.md"
}
