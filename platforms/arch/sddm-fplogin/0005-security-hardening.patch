+        QTRY_VERIFY(display.m_contextCommitted);
+        const bool fpAuth = display.peers.value(int(AuthMethod::Fingerprint)).authorized;
+        const bool pwAuth = display.peers.value(int(AuthMethod::Password)).authorized;
