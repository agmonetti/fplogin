 #include <QtCore/QUuid>
 #include <QtCore/QFile>
 #include <QtCore/QDebug>
+#include <QtCore/QElapsedTimer>
+#include <QtCore/QThread>
 #include <QtNetwork/QLocalSocket>
 
 #include <iostream>
 #include <unistd.h>
 #include <sys/socket.h>
