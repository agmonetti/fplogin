 namespace SDDM {
+    AuthLaunchObservation::AuthLaunchObservation(const AuthLaunchRecord &record, QProcess *process)
+        : QObject(QCoreApplication::instance()), m_record(record), m_process(process) {
+        process->setParent(this);
+    }
+
+    AuthLaunchRecord AuthLaunchObservation::record() const { return m_record; }
+    void AuthLaunchObservation::retainEvidence() { m_retained = true; }
+
+    qint64 AuthLaunchObservation::monotonicMs() {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    bool AuthLaunchObservation::cancelExact(const AuthLaunchRecord &expected) {
+        if (expected.requestId != m_record.requestId || expected.method != m_record.method
+            || expected.generation != m_record.generation || expected.authId != m_record.authId
+            || expected.user != m_record.user)
+            return false;
+        if (m_cancelled)
+            return true;
+        m_cancelled = true;
+        // Invalidate even a captured-but-unpublished exit before terminal draining.
+        if (m_invalidate)
+            m_invalidate();
+        if (m_record.state == AuthLaunchRecord::Exited
+            || m_record.state == AuthLaunchRecord::FailedToStart)
+            return true;
+        if (m_process) {
+            m_process->terminate();
