+            const auto entry = entries.first().toObject();
+            QCOMPARE(entry.value(QStringLiteral("state")).toString(), QStringLiteral("exited"));
+            QVERIFY(entry.value(QStringLiteral("pid")).toString().toLongLong() > 0);
+            QCOMPARE(entry.value(QStringLiteral("exitStatus")).toString(), mode == QLatin1String("normal") ? QStringLiteral("normal") : QStringLiteral("crash"));
+        }
+        QVERIFY(!display || !display->peers.value(int(AuthMethod::Password)).authorized);
+        QCOMPARE(authority->result(), result);
+    }
