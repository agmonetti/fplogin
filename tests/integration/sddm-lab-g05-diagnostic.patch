+    void diagnosticAbortMaximalFrame() {
+        if (geteuid() || !QFile::exists(QStringLiteral("/.dockerenv"))) QSKIP("Offline root fixture only");
+        QTemporaryDir privateDirectory(QStringLiteral("/run/g05-abort-XXXXXX"));
+        std::unique_ptr<DiagnosticControl> control(DiagnosticControl::fromArguments(
+            {QStringLiteral("sddm"), QStringLiteral("--g05-control-dir"), privateDirectory.path()}, qApp));
+        Harness display(directory->filePath(QStringLiteral("control")));
+        Supervisor supervisor;
+        bindSupervisor(*control, supervisor);
+        Client client;
+        connectClient(display, client);
+        // Select with maximal legal username (256 bytes) and valid session
+        const QString maxUser(250, QLatin1Char('u'));
+        select(client, 1, maxUser);
+        QTRY_COMPARE(supervisor.messages.size(), 2);
+        auto reserved = supervisor.messages.last();
+        QCOMPARE(reserved.value(QStringLiteral("user")).toString(), maxUser);
+
+        const auto req = reserved.value(QStringLiteral("request")).toString();
+        // Also register both helper observations to exercise maximal legal two-entry ledger
+        auto *passAuth = display.m_auth;
+        passAuth->setRequestId(req);
+        passAuth->setUser(maxUser);
+        passAuth->setSession(QStringLiteral("ignore-term"));
+        passAuth->setDeferredAuthorization(true);
+        passAuth->setDisplayServerCommand(display.controls.fullServerName());
+        passAuth->start();
+        QTRY_VERIFY(display.peers.contains(int(AuthMethod::Password)));
+
+        auto *fpAuth = display.m_fingerprintAuth;
+        fpAuth->setMethod(AuthMethod::Fingerprint);
+        fpAuth->setRequestId(req);
+        fpAuth->setUser(maxUser);
+        fpAuth->setSession(QStringLiteral("ignore-term"));
+        fpAuth->setDeferredAuthorization(true);
+        fpAuth->setDisplayServerCommand(display.controls.fullServerName());
+        fpAuth->start();
+        QTRY_VERIFY(display.peers.contains(int(AuthMethod::Fingerprint)));
+
+        display.command(AuthMethod::Password, "E");
+        display.command(AuthMethod::Fingerprint, "E");
+        QTRY_COMPARE(passAuth->launchObservation()->record().state, AuthLaunchRecord::Exited);
+        QTRY_COMPARE(fpAuth->launchObservation()->record().state, AuthLaunchRecord::Exited);
+
+        auto abort = reserved;
+        abort.insert(QStringLiteral("type"), QStringLiteral("ABORT"));
+        const auto payload = QJsonDocument(abort).toJson(QJsonDocument::Compact);
+        QVERIFY(payload.size() >= 400 && payload.size() <= 4096);
+
+        // Large legal frame: valid payload with 250-character username and 2 launch entries
+        supervisor.send(abort);
+        QTRY_COMPARE(supervisor.messages.size(), 3);
+        const auto status = supervisor.messages.last();
+        QCOMPARE(status.value(QStringLiteral("type")).toString(), QStringLiteral("ABORT_STATUS"));
+        QCOMPARE(status.value(QStringLiteral("phase")).toString(), QStringLiteral("aborted"));
+        QCOMPARE(status.value(QStringLiteral("outcome")).toString(), QStringLiteral("exits_observed"));
+        const auto statusPayload = QJsonDocument(status).toJson(QJsonDocument::Compact);
+        QVERIFY(statusPayload.size() >= 500 && statusPayload.size() <= 4096);
+        const auto launches = status.value(QStringLiteral("launches")).toArray();
+        QCOMPARE(launches.size(), 2);
+
+        // Oversized frame > 4096 bytes: in terminal state, must close transport without rewriting frozen result
+        supervisor.socket.write(packet([](QDataStream &out) { out << quint32(4097); }));
+        supervisor.socket.flush();
+        QCOMPARE(control->state(), DiagnosticControl::State::Aborted);
+        QTRY_COMPARE(supervisor.socket.state(), QLocalSocket::UnconnectedState);
+    }
+    void diagnosticAbortStalledFlushAndBackpressure() {
+        if (geteuid() || !QFile::exists(QStringLiteral("/.dockerenv"))) QSKIP("Offline root fixture only");
+        QTemporaryDir privateDirectory(QStringLiteral("/run/g05-abort-XXXXXX"));
+        std::unique_ptr<DiagnosticControl> control(DiagnosticControl::fromArguments(
+            {QStringLiteral("sddm"), QStringLiteral("--g05-control-dir"), privateDirectory.path()}, qApp));
+        Harness display(directory->filePath(QStringLiteral("control")));
+        Supervisor supervisor;
+        bindSupervisor(*control, supervisor);
+        Client client;
+        connectClient(display, client);
+        select(client, 1, QStringLiteral("root"));
+        QTRY_COMPARE(supervisor.messages.size(), 2);
+        auto abort = supervisor.messages.last();
+        abort.insert(QStringLiteral("type"), QStringLiteral("ABORT"));
+
+        // Test backpressure: payload is small and legal (<= MaxFrame), but queued output causes
+        // bytesToWrite() + payload.size() + 4 > MaxFrame + 4, failing send() with transport_error
+        const auto payload = QJsonDocument(abort).toJson(QJsonDocument::Compact);
+        QVERIFY(!payload.isEmpty() && payload.size() <= 4096);
+        control->m_supervisor->write(QByteArray(4096 - payload.size() + 10, 'p'));
+        QVERIFY(control->m_supervisor->bytesToWrite() > 0);
+        QVERIFY(control->m_supervisor->bytesToWrite() + payload.size() + 4 > 4096 + 4);
+        QVERIFY(!control->send(abort));
+        QCOMPARE(control->state(), DiagnosticControl::State::Failed);
+        QCOMPARE(control->m_abort->result().value(QStringLiteral("reason")).toString(), QStringLiteral("transport_error"));
+
+        // Stalled peer forced flush: arm flush deadline as expired, queue unread bytes, then fire
+        // the flush timer callback to verify that forced close aborts despite bytesToWrite() > 0
+        control->m_supervisor->write(QByteArray(100, 'q'));
+        QVERIFY(control->m_supervisor->bytesToWrite() > 0);
+        control->m_flushDeadline.setRemainingTime(0);
+        QVERIFY(control->m_flushDeadline.hasExpired());
+        control->m_flushTimer.start(0);
+        QTRY_COMPARE(supervisor.socket.state(), QLocalSocket::UnconnectedState);
+    }
