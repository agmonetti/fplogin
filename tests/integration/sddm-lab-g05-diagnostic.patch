+#!/usr/bin/env python3
+"""Offline unit test for g05-success-first-controller.py: watchdog recovery and event logic."""
+
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import tempfile
+import time
+import uuid
+
+controller_script = Path(__file__).parent / "g05-success-first-controller.py"
+assert controller_script.is_file()
+
+def test_watchdog_cleanup_on_sigkill():
+    with tempfile.TemporaryDirectory() as tmpdir:
+        gate_dir = Path(tmpdir) / "gates"
+        gate_dir.mkdir(mode=0o700)
+        trace_file = Path(tmpdir) / "trace.jsonl"
+        trace_file.touch()
+        req = str(uuid.uuid4())
+
+        # Start controller as a subprocess
+        proc = subprocess.Popen([
+            sys.executable, str(controller_script),
+            "--trace", str(trace_file),
+            "--gate-dir", str(gate_dir),
+            "--request", req,
+            "--timeout", "10",
+        ])
+        
+        # Wait for pw_gate to appear
+        pw_gate = gate_dir / f"hold-password-{req}"
+        end = time.monotonic() + 3
+        while not pw_gate.exists() and time.monotonic() < end:
+            time.sleep(0.02)
+        assert pw_gate.exists(), "pw_gate was not created by controller"
+
+        # Simulate abrupt SIGKILL of controller
+        proc.kill()
+        proc.wait()
+
+        # Watchdog must detect pipe closure and unlink the gate file
+        end = time.monotonic() + 3
+        while pw_gate.exists() and time.monotonic() < end:
+            time.sleep(0.02)
+        assert not pw_gate.exists(), "companion watchdog failed to clean up gate after SIGKILL!"
+        print("PASS: test_watchdog_cleanup_on_sigkill")
+
+
+def test_controller_simulated_success_first():
+    with tempfile.TemporaryDirectory() as tmpdir:
+        gate_dir = Path(tmpdir) / "gates"
+        gate_dir.mkdir(mode=0o700)
+        trace_file = Path(tmpdir) / "trace.jsonl"
+        req = str(uuid.uuid4())
+
+        # Start controller with short margin
+        proc = subprocess.Popen([
+            sys.executable, str(controller_script),
+            "--trace", str(trace_file),
+            "--gate-dir", str(gate_dir),
+            "--request", req,
+            "--margin-seconds", "0.5",
+            "--timeout", "10",
+        ], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+
+        pw_gate = gate_dir / f"hold-password-{req}"
+        end = time.monotonic() + 3
+        while not pw_gate.exists() and time.monotonic() < end:
+            time.sleep(0.02)
+        assert pw_gate.exists()
+
+        def emit(event, **fields):
+            with trace_file.open("a") as f:
+                f.write(json.dumps({"event": event, "request": req, **fields}) + "\n")
+                f.flush()
+
+        # Simulate SDDM events
+        emit("deadline-armed", duration_ms=2000, serial=1, generation=1)
+        emit("helper-start", role="fingerprint", helper_pid=1234, generation=1)
+        time.sleep(0.1)
+        fp_gate = gate_dir / f"hold-{req}-1234"
+        assert fp_gate.exists(), "fp_gate was not created"
+
+        emit("helper-start", role="password", helper_pid=1235, generation=1)
+
+        # Wait for monotonic release (2s - 0.5s = 1.5s)
+        time.sleep(1.6)
+        assert not fp_gate.exists(), "fp_gate was not released before deadline"
+
+        # Winner selected before deadline-fired
+        emit("winner-selected", method=1, generation=1)
+        emit("loser-barrier-wait", loser_method=0)
+        emit("helper-exit", role="password", helper_pid=1235)
+        emit("loser-barrier-release")
+        emit("winner-authorize", method=1)
+        emit("session-open-success", success=True)
+
+        stdout, stderr = proc.communicate(timeout=5)
+        assert proc.returncode == 0, f"controller failed: stdout={stdout} stderr={stderr}"
+        res = json.loads(stdout)
+        assert res.get("verified") is True
+        assert res.get("winner_selected") is True
+        assert res.get("deadline_fired") is False
+        assert not pw_gate.exists()
+        assert not fp_gate.exists()
+        print("PASS: test_controller_simulated_success_first")
+
+
+if __name__ == "__main__":
+    import sys
+    test_watchdog_cleanup_on_sigkill()
+    test_controller_simulated_success_first()
+    print("ALL CONTROLLER UNIT TESTS PASSED.")
