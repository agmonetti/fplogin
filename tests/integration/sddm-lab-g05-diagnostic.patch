+        QFETCH(QString, failure);
+        QTemporaryDir privateDirectory(QStringLiteral("/run/g05-control-XXXXXX"));
+        QVERIFY(privateDirectory.isValid());
+        QString path = privateDirectory.path();
+        QStringList args {QStringLiteral("sddm"), QStringLiteral("--g05-control-dir"), path};
+        if (failure == QLatin1String("mode"))
+            QVERIFY(!::chmod(QFile::encodeName(path).constData(), 0755));
+        else if (failure == QLatin1String("owner"))
+            QVERIFY(!::chown(QFile::encodeName(path).constData(), 65534, 65534));
+        else if (failure == QLatin1String("symlink")) {
+            const auto alias = path + QStringLiteral("/alias");
+            QVERIFY(!::symlink(".", QFile::encodeName(alias).constData()));
+            args.last() = alias;
+        } else if (failure == QLatin1String("existing")) {
+            QFile file(path + QStringLiteral("/control.sock"));
+            QVERIFY(file.open(QIODevice::WriteOnly));
+            file.write("not-owned-by-control");
+        } else if (failure == QLatin1String("missing"))
+            args.removeLast();
+        else if (failure == QLatin1String("duplicate"))
+            args << QStringLiteral("--g05-control-dir") << path;
+        else if (failure == QLatin1String("equals"))
+            args = {QStringLiteral("sddm"), QStringLiteral("--g05-control-dir=") + path};
+        else if (failure == QLatin1String("absent"))
+            args = {QStringLiteral("sddm")};
+        std::unique_ptr<DiagnosticControl> control(DiagnosticControl::fromArguments(args, qApp));
+        if (failure == QLatin1String("absent")) {
+            QVERIFY(!control && !DiagnosticControl::forApplication());
+        } else {
