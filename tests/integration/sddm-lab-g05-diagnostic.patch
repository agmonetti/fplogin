+        if (failure == QLatin1String("context-timeout")) {
+            bindSupervisor(*control, supervisor);
+        } else if (failure != QLatin1String("bootstrap-timeout")) {
+            supervisor.socket.connectToServer(control->address());
+            QTRY_COMPARE(supervisor.socket.state(), QLocalSocket::ConnectedState);
+            if (failure == QLatin1String("hello-slow-fragments")) {
+                // A byte every 100ms cannot renew the phase's absolute deadline.
+                supervisor.socket.write(packet([](QDataStream &out) { out << quint32(4096); }));
+                QObject::connect(&fragments, &QTimer::timeout, &supervisor.socket, [&] {
+                    if (supervisor.socket.state() == QLocalSocket::ConnectedState)
+                        supervisor.socket.write(" ", 1);
+                });
+                fragments.start(100);
+            } else {
+                QFile boot(QStringLiteral("/proc/sys/kernel/random/boot_id"));
+                QVERIFY(boot.open(QIODevice::ReadOnly));
+                QJsonObject hello {{QStringLiteral("type"), QStringLiteral("HELLO")}, {QStringLiteral("version"), 1},
+                                   {QStringLiteral("boot"), QString::fromLatin1(boot.readAll()).trimmed()}};
+                hello.insert(failure == QLatin1String("hello-boot") ? QStringLiteral("boot") : QStringLiteral("version"),
+                             QStringLiteral("foreign"));
