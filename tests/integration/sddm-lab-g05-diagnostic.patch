+#!/usr/bin/env python3
+"""Autonomous, guest-event-driven success-first controller for G05.
+
+Controls the genuine success-first race using monotonic guest event timing:
+1. Holds real password helper before PAM as the live loser.
+2. Holds genuine fingerprint PAM success before AUTHENTICATED frame.
+3. Releases fingerprint success before the nominal deadline (e.g. t0 + duration - margin).
+4. Verifies winner-selected (fingerprint) occurs and deadline timer remains disarmed (no deadline-fired).
+5. Password helper receives terminate/kill; once password helper exits, loser barrier releases.
+6. A companion watchdog guarantees that even if this controller process is killed (SIGKILL/SIGTERM),
+   all gate files are unlinked so no helper remains stuck.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import select
+import signal
+import sys
+import time
+
+
+def spawn_watchdog(gate_dir: Path, request: str):
+    """Spawns an independent companion process that unlinks gates if parent dies."""
+    pipe_r, pipe_w = os.pipe()
+    pid = os.fork()
+    if pid == 0:
+        # Child watchdog process
+        os.close(pipe_w)
+        # Block until parent closes pipe (normal exit, crash, or SIGKILL)
+        try:
+            os.read(pipe_r, 1)
+        except Exception:
+            pass
+        os.close(pipe_r)
+        # Parent died: emergency gate cleanup
+        if gate_dir.is_dir():
+            for p in gate_dir.glob(f"hold-*{request}*"):
+                try:
+                    p.unlink(missing_ok=True)
+                except Exception:
+                    pass
+        os._exit(0)
+    # Parent process
+    os.close(pipe_r)
+    return pid, pipe_w
+
+
+class SuccessFirstController:
+    def __init__(self, trace: Path, gate_dir: Path, request: str, margin_seconds: float, timeout: float):
+        self.trace = trace
+        self.gate_dir = gate_dir
+        self.request = request
+        self.margin_seconds = margin_seconds
+        self.timeout = timeout
+        self.pw_gate = self.gate_dir / f"hold-password-{request}"
+        self.fp_gate = None
+        self.fp_pid = None
+        self.pw_pid = None
+        self.armed_time = None
+        self.duration_s = 30.0
+        self.release_deadline = None
+        self.fp_released = False
+        self.winner_selected = False
+        self.deadline_fired = False
+        self.loser_barrier_wait = False
+        self.loser_barrier_release = False
+        self.pw_exited = False
+        self.winner_authorized = False
+        self.session_success = False
+
+    def setup(self):
+        self.gate_dir.mkdir(mode=0o700, exist_ok=True)
+        # Pre-arm password gate before password helper launches
+        self.pw_gate.touch(mode=0o600)
+        assert self.pw_gate.stat().st_mode & 0o777 == 0o600
+
+    def cleanup(self):
+        if self.fp_gate and self.fp_gate.exists():
+            self.fp_gate.unlink(missing_ok=True)
+        if self.pw_gate.exists():
+            self.pw_gate.unlink(missing_ok=True)
+
+    def run(self):
+        self.setup()
+        start_time = time.monotonic()
+        end_time = start_time + self.timeout
+        if not self.trace.exists():
+            self.trace.touch()
+
+        with self.trace.open("r") as f:
+            # Seek to end or start as appropriate
+            f.seek(0, os.SEEK_END)
+            while time.monotonic() < end_time:
+                line = f.readline()
+                if not line:
+                    # Check if monotonic release time reached
+                    if self.release_deadline and not self.fp_released:
+                        if time.monotonic() >= self.release_deadline:
+                            if self.fp_gate and self.fp_gate.exists():
+                                self.fp_gate.unlink()
+                                self.fp_released = True
+                    time.sleep(0.02)
+                    continue
+
+                if not line.endswith("\n"):
+                    continue
+
+                try:
+                    event = json.loads(line)
+                except Exception:
+                    continue
+
+                req = event.get("request")
+                if req and req != self.request:
+                    continue
+
+                ev = event.get("event")
+
+                if ev == "deadline-armed":
+                    self.armed_time = time.monotonic()
+                    dur_ms = int(event.get("duration_ms", 30000))
+                    self.duration_s = dur_ms / 1000.0
+                    self.release_deadline = self.armed_time + max(0.5, self.duration_s - self.margin_seconds)
+
+                elif ev == "helper-start":
+                    role = event.get("role")
+                    pid = event.get("helper_pid")
+                    if role == "fingerprint" and pid:
+                        self.fp_pid = int(pid)
+                        self.fp_gate = self.gate_dir / f"hold-{self.request}-{self.fp_pid}"
+                        self.fp_gate.touch(mode=0o600)
+                    elif role == "password" and pid:
+                        self.pw_pid = int(pid)
+
+                elif ev == "deadline-fired":
+                    self.deadline_fired = True
+
+                elif ev == "winner-selected":
+                    method = int(event.get("method", -1))
+                    if method == 1:
+                        self.winner_selected = True
+
+                elif ev == "loser-barrier-wait":
+                    self.loser_barrier_wait = True
+
+                elif ev == "helper-exit":
+                    role = event.get("role")
+                    if role == "password":
+                        self.pw_exited = True
+                        if self.pw_gate.exists():
+                            self.pw_gate.unlink()
+
+                elif ev == "loser-barrier-release":
+                    self.loser_barrier_release = True
+
+                elif ev == "winner-authorize":
+                    self.winner_authorized = True
+
+                elif ev == "session-open-success" or ev == "session-result":
+                    if event.get("success") in (True, "true"):
+                        self.session_success = True
+                        break
+
+                # Continuous release check
+                if self.release_deadline and not self.fp_released:
+                    if time.monotonic() >= self.release_deadline:
+                        if self.fp_gate and self.fp_gate.exists():
+                            self.fp_gate.unlink()
+                            self.fp_released = True
+
+        return {
+            "request": self.request,
+            "winner_selected": self.winner_selected,
+            "deadline_fired": self.deadline_fired,
+            "loser_barrier_wait": self.loser_barrier_wait,
+            "pw_exited": self.pw_exited,
+            "loser_barrier_release": self.loser_barrier_release,
+            "winner_authorized": self.winner_authorized,
+            "session_success": self.session_success,
+            "verified": (
+                self.winner_selected
+                and not self.deadline_fired
+                and self.pw_exited
+                and self.loser_barrier_release
+                and self.winner_authorized
+                and self.session_success
+            ),
+        }
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--trace", required=True, type=Path, help="Collector trace JSONL path")
+    p.add_argument("--gate-dir", default=Path("/run/fplogin-g05"), type=Path, help="Gate directory")
+    p.add_argument("--request", required=True, help="Target request UUID")
+    p.add_argument("--margin-seconds", type=float, default=3.0, help="Margin before deadline expiry to release fingerprint")
+    p.add_argument("--timeout", type=float, default=60.0, help="Maximum execution ceiling")
+    args = p.parse_args()
+
+    watchdog_pid, pipe_w = spawn_watchdog(args.gate_dir, args.request)
+    controller = SuccessFirstController(
+        args.trace, args.gate_dir, args.request, args.margin_seconds, args.timeout
+    )
+
+    def on_signal(signum, frame):
+        controller.cleanup()
+        sys.exit(128 + signum)
+
+    signal.signal(signal.SIGINT, on_signal)
+    signal.signal(signal.SIGTERM, on_signal)
+
+    try:
+        verdict = controller.run()
+        print(json.dumps(verdict, indent=2))
+        sys.exit(0 if verdict.get("verified") else 1)
+    finally:
+        controller.cleanup()
+        # Close pipe to terminate companion watchdog cleanly
+        try:
+            os.close(pipe_w)
+            os.waitpid(watchdog_pid, 0)
+        except Exception:
+            pass
+
+
+if __name__ == "__main__":
+    main()
