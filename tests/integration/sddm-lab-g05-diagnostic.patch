+#include "DiagnosticControl.h"
+#include "Display.h"
+#include "SocketServer.h"
+
+#include <QCoreApplication>
+#include <QDataStream>
+#include <QFile>
+#include <QJsonDocument>
+#include <QLocalSocket>
+#include <QSocketNotifier>
+#include <QUuid>
+
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace SDDM {
+namespace {
+constexpr int MaxFrame = 4096;
+constexpr char BootstrapLatch[] = "_sddm_g05_control_bootstrapped";
+QString uuid() { return QUuid::createUuid().toString(QUuid::WithoutBraces); }
+}
+
+DiagnosticControl::DiagnosticControl(QObject *parent) : QObject(parent) {
+    m_timer.setSingleShot(true);
+    connect(&m_timer, &QTimer::timeout, this, &DiagnosticControl::fail);
+}
+
+DiagnosticControl *DiagnosticControl::forApplication() {
+    return QCoreApplication::instance()->findChild<DiagnosticControl *>(QString(), Qt::FindDirectChildrenOnly);
+}
+
+bool DiagnosticControl::enabledForApplication() {
+    return QCoreApplication::instance()->property(BootstrapLatch).toBool();
+}
+
+DiagnosticControl *DiagnosticControl::fromArguments(const QStringList &arguments, QObject *application) {
+    if (application != QCoreApplication::instance() || enabledForApplication())
+        qFatal("Duplicate or invalid diagnostic bootstrap");
+    const QString option = QStringLiteral("--g05-control-dir");
+    int index = -1, count = 0;
+    for (int i = 0; i < arguments.size(); ++i) {
+        if (arguments.at(i) == option || arguments.at(i).startsWith(option + QLatin1Char('='))) {
+            index = i;
+            ++count;
+        }
+    }
+    if (!count)
+        return nullptr;
+    application->setProperty(BootstrapLatch, true); // Irreversible for this daemon's lifetime.
+    auto *control = new DiagnosticControl(application);
+    if (count != 1 || arguments.at(index) != option || index + 1 >= arguments.size()
+        || !control->listen(arguments.at(index + 1)))
+        return control;
+    control->phase(State::WaitingSupervisor);
+    return control;
+}
+
+bool DiagnosticControl::listen(const QString &directory) {
+#ifndef SO_PEERCRED
+    Q_UNUSED(directory);
+    return false;
+#else
+    // Pin every component; neither symlinks nor non-root writable parents are trusted.
+    if (geteuid() != 0 || !directory.startsWith(QLatin1Char('/'))
+        || QDir::cleanPath(directory) != directory || directory == QLatin1String("/")
+        || QFile::encodeName(directory + QStringLiteral("/control.sock")).size() >= int(sizeof(sockaddr_un::sun_path)))
+        return false;
+    int fd = ::open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0)
+        return false;
+    const auto components = directory.mid(1).split(QLatin1Char('/'));
+    for (int i = 0; i < components.size(); ++i) {
+        const auto component = QFile::encodeName(components.at(i));
+        const int next = ::openat(fd, component.constData(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        ::close(fd);
+        if (next < 0)
+            return false;
+        fd = next;
+        struct stat st {};
+        if (::fstat(fd, &st) || st.st_uid != 0 || st.st_gid != 0
+            || (st.st_mode & 0022) || (i == components.size() - 1 && (st.st_mode & 07777) != 0700)) {
+            ::close(fd);
+            return false;
+        }
+    }
+    m_dirFd = fd;
+    struct stat st {};
+    if (::fstatat(fd, "control.sock", &st, AT_SYMLINK_NOFOLLOW) == 0 || errno != ENOENT)
+        return false;
+    QFile boot(QStringLiteral("/proc/sys/kernel/random/boot_id"));
+    if (!boot.open(QIODevice::ReadOnly))
+        return false;
+    m_boot = QString::fromLatin1(boot.read(64)).trimmed();
+    if (m_boot.size() != 36 || QUuid(m_boot).isNull())
+        return false;
+    m_epoch = uuid();
+    // Native listener: QLocalServer::close unlinks even a substituted pathname.
+    // Cleanup below removes only the inode we created in the pinned directory.
+    const int socketFd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (socketFd < 0)
+        return false;
+    sockaddr_un name {};
+    name.sun_family = AF_UNIX;
+    const auto pinnedPath = QStringLiteral("/proc/self/fd/%1/control.sock").arg(fd).toLatin1();
+    if (pinnedPath.size() >= int(sizeof(name.sun_path))) {
+        ::close(socketFd);
+        return false;
+    }
+    std::memcpy(name.sun_path, pinnedPath.constData(), pinnedPath.size() + 1);
+    if (::bind(socketFd, reinterpret_cast<sockaddr *>(&name), sizeof(name))) {
+        ::close(socketFd);
+        return false;
+    }
+    if (::fstatat(fd, "control.sock", &st, AT_SYMLINK_NOFOLLOW)) {
+        ::close(socketFd);
+        return false;
+    }
+    m_device = st.st_dev;
+    m_inode = st.st_ino;
+    if (::fchmodat(fd, "control.sock", 0600, 0) || !S_ISSOCK(st.st_mode)
+        || st.st_uid != 0 || st.st_gid != 0 || ::listen(socketFd, 4)) {
+        ::close(socketFd);
+        return false;
+    }
+    m_listenerFd = socketFd;
+    m_notifier = new QSocketNotifier(socketFd, QSocketNotifier::Read, this);
+    connect(m_notifier, &QSocketNotifier::activated, this, [this] { accept(); });
+    m_address = directory + QStringLiteral("/control.sock");
+    return true;
+#endif
+}
+
+DiagnosticControl::~DiagnosticControl() {
+    fail();
+    if (m_notifier)
+        m_notifier->setEnabled(false);
+    if (m_listenerFd >= 0) {
+        ::close(m_listenerFd);
+        m_listenerFd = -1;
+    }
+    if (m_supervisor)
+        m_supervisor->abort();
+    if (m_dirFd >= 0) {
+        struct stat st {};
+        if (m_inode && !::fstatat(m_dirFd, "control.sock", &st, AT_SYMLINK_NOFOLLOW)
+            && quint64(st.st_dev) == m_device && quint64(st.st_ino) == m_inode && S_ISSOCK(st.st_mode))
+            ::unlinkat(m_dirFd, "control.sock", 0);
+        ::close(m_dirFd);
+    }
+}
+
+void DiagnosticControl::phase(State state) {
+    m_state = state;
+    m_timer.stop();
+    m_deadline = QDeadlineTimer(TimeoutMs, Qt::PreciseTimer);
+    if (state != State::ReservedConfirmed && state != State::Failed)
+        m_timer.start(TimeoutMs);
+}
+
+void DiagnosticControl::accept() {
+#ifdef SO_PEERCRED
+    // Bound work per event-loop turn, including unauthorized/extra connections.
+    for (int i = 0; i < 4; ++i) {
+        const int fd = ::accept4(m_listenerFd, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+        if (fd < 0) {
+            if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+                m_notifier->setEnabled(false);
+                fail();
+            }
+            return;
+        }
+        struct ucred credentials {};
+        socklen_t size = sizeof(credentials);
+        const bool authorized = !::getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credentials, &size)
+            && size == sizeof(credentials) && credentials.uid == 0;
+        if (!authorized || m_supervisor || m_state != State::WaitingSupervisor || m_deadline.hasExpired()) {
+            ::close(fd);
+            continue;
+        }
+        auto *socket = new QLocalSocket(this);
+        if (!socket->setSocketDescriptor(fd)) {
+            ::close(fd);
+            socket->deleteLater();
+            fail();
+            return;
+        }
+        m_supervisor = socket;
+        socket->setReadBufferSize(MaxFrame + 4);
+        connect(socket, &QLocalSocket::readyRead, this, &DiagnosticControl::read);
+        connect(socket, &QLocalSocket::disconnected, this, &DiagnosticControl::fail);
+        connect(socket, &QLocalSocket::errorOccurred, this, [this] { fail(); });
+        read();
+    }
+#endif
+}
+
+bool DiagnosticControl::send(const QJsonObject &object) {
+    const auto payload = QJsonDocument(object).toJson(QJsonDocument::Compact);
+    if (!m_supervisor || payload.isEmpty() || payload.size() > MaxFrame
+        || m_supervisor->bytesToWrite() + payload.size() + 4 > MaxFrame + 4) {
+        fail();
+        return false;
+    }
+    QByteArray frame;
+    QDataStream out(&frame, QIODevice::WriteOnly);
+    out << quint32(payload.size());
+    frame.append(payload);
+    if (m_supervisor->write(frame) != frame.size()) {
+        fail();
+        return false;
+    }
+    return true;
+}
+
+void DiagnosticControl::read() {
+    if (!m_supervisor || m_state == State::Failed)
+        return;
+    m_input.append(m_supervisor->read(MaxFrame + 4 - m_input.size()));
+    while (m_input.size() >= 4) {
+        quint32 length = 0;
+        QDataStream header(m_input.left(4));
+        header >> length;
+        if (!length || length > MaxFrame) { fail(); return; }
+        if (m_input.size() < length + 4) {
+            if (m_supervisor->bytesAvailable())
+                QTimer::singleShot(0, this, &DiagnosticControl::read);
+            return;
+        }
+        const auto payload = m_input.mid(4, length);
+        m_input.remove(0, length + 4);
+        QJsonParseError error;
+        const auto document = QJsonDocument::fromJson(payload, &error);
+        // Canonical encoding also rejects duplicate keys and alternative spellings.
+        if (error.error != QJsonParseError::NoError || !document.isObject()
+            || document.toJson(QJsonDocument::Compact) != payload) { fail(); return; }
+        process(document.object());
+        if (m_state == State::Failed)
+            return;
+    }
+    if (m_supervisor->bytesAvailable())
+        QTimer::singleShot(0, this, &DiagnosticControl::read);
+}
+
+void DiagnosticControl::process(const QJsonObject &object) {
+    if (m_state != State::ReservedConfirmed && m_deadline.hasExpired()) { fail(); return; }
+    if (m_state == State::WaitingSupervisor) {
+        const QJsonObject hello {{QStringLiteral("version"), 1}, {QStringLiteral("type"), QStringLiteral("HELLO")},
+                                 {QStringLiteral("boot"), m_boot}};
+        if (object != hello) { fail(); return; }
+        phase(State::WaitingContext);
+        send({{QStringLiteral("version"), 1}, {QStringLiteral("type"), QStringLiteral("BOUND")},
+              {QStringLiteral("boot"), m_boot}, {QStringLiteral("epoch"), m_epoch}});
+        return;
+    }
+    auto confirm = m_binding;
+    confirm.insert(QStringLiteral("type"), QStringLiteral("CONFIRM"));
+    if (m_state != State::AwaitConfirm || object != confirm || !m_display || !m_greeter) {
+        fail();
+        return;
+    }
+    phase(State::ReservedConfirmed);
+    m_display->stageAuthenticationContext(m_greeter, m_display->m_diagnosticSerial, true,
+                                         m_display->m_diagnosticUser, m_display->m_diagnosticSession);
+}
+
+void DiagnosticControl::attach(Display *display) {
+    if (m_attached) { fail(); return; }
+    m_attached = true;
+    m_display = display;
+    connect(display, &QObject::destroyed, this, &DiagnosticControl::fail);
+}
+
+void DiagnosticControl::reject(QLocalSocket *socket, quint64 serial) {
+    if (!socket)
+        return;
+    if (m_display)
+        m_display->m_socketServer->authenticationContext(socket, serial, 0, QString(), QString(), Session(),
+            quint32(AuthenticationAvailability::Unavailable), quint32(AuthenticationPhase::Idle),
+            QStringLiteral("diagnostic_control_failed"));
+    socket->disconnectFromServer();
+}
+
+void DiagnosticControl::reserve(Display *display, QLocalSocket *socket, quint64 serial, bool hasContext,
+                                const QString &user, const Session &session) {
+    if (m_display != display || m_state != State::WaitingContext || m_deadline.hasExpired()
+        || !hasContext || !m_supervisor || !display->reserveDiagnosticContext(socket, serial, user, session)) {
+        fail();
+        reject(socket, serial);
+        return;
+    }
+    m_greeter = socket;
+    m_binding = {{QStringLiteral("version"), 1}, {QStringLiteral("type"), QStringLiteral("RESERVED")},
+                 {QStringLiteral("boot"), m_boot}, {QStringLiteral("epoch"), m_epoch},
+                 {QStringLiteral("transaction"), uuid()}, {QStringLiteral("socketId"), uuid()},
+                 {QStringLiteral("serial"), QString::number(serial)},
+                 {QStringLiteral("request"), display->m_diagnosticRequest}, {QStringLiteral("user"), user},
+                 {QStringLiteral("sessionType"), int(session.type())}, {QStringLiteral("sessionFile"), session.fileName()},
+                 {QStringLiteral("passwordGeneration"), QString::number(display->m_auth->launchGeneration() + 1)},
+                 {QStringLiteral("fingerprintGeneration"), QString::number(display->m_fingerprintAuth->launchGeneration() + 1)}};
+    phase(State::AwaitConfirm);
+    send(m_binding);
+}
+
+bool DiagnosticControl::confirmedFor(Display *display, QLocalSocket *socket, quint64 serial) const {
+    return m_state == State::ReservedConfirmed && display == m_display && socket && socket == m_greeter
+        && QString::number(serial) == m_binding.value(QStringLiteral("serial")).toString();
+}
+
+void DiagnosticControl::greeterDisconnected(QLocalSocket *socket) {
+    if (socket == m_greeter)
+        fail();
+}
+
+void DiagnosticControl::fail() {
+    if (m_state == State::Failed)
+        return;
+    phase(State::Failed);
+    m_input.clear();
+    emit failed(); // Clear pending context before any disconnect or queued callback.
+    reject(m_greeter, m_binding.value(QStringLiteral("serial")).toString().toULongLong());
+    m_greeter.clear();
+    if (m_supervisor)
+        m_supervisor->abort();
+}
+}
