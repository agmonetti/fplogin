+    void realPamSuccessBeforeDeadlineLoserExitsAfter() {
+#ifndef G05_INTEGRATED
+        QSKIP("Requires disposable-container PAM and real helper");
+#else
+        QVERIFY(QFile::exists(QStringLiteral("/.dockerenv")));
+        QVERIFY(QFile::exists(QStringLiteral("/lab/g05-pam.so")));
+        mainConfig.FingerprintAuthTimeout.set(4);
+        static QList<QPair<QString, qint64>> events;
+        events.clear();
+        const auto previous = qInstallMessageHandler([](QtMsgType, const QMessageLogContext &, const QString &message) {
+            if (message.contains(QStringLiteral("FPLOGIN_TRACE")))
+                events.append({message, AuthLaunchObservation::monotonicMs()});
+        });
+        struct Restore {
+            QtMessageHandler previous;
+            QString gate;
+            ~Restore() { qInstallMessageHandler(previous); QFile::remove(gate); QDir().rmdir(QStringLiteral("/run/fplogin-g05")); }
+        } restore { previous, {} };
+        Harness display(directory->filePath(QStringLiteral("control")));
+        Client client;
+        connectClient(display, client);
+        select(client, 1, QStringLiteral("root"));
+        QTRY_COMPARE(display.m_contextUser, QStringLiteral("root"));
+        QVERIFY(QDir().mkdir(QStringLiteral("/run/fplogin-g05")));
+        QVERIFY(QFile::setPermissions(QStringLiteral("/run/fplogin-g05"),
+                                      QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+        restore.gate = QStringLiteral("/run/fplogin-g05/hold-password-") + display.m_requestId;
+        QFile gate(restore.gate);
+        QVERIFY(gate.open(QIODevice::WriteOnly | QIODevice::NewOnly));
+        gate.close();
+        QVERIFY(gate.setPermissions(QFile::ReadOwner | QFile::WriteOwner));
+        display.setFingerprintAvailability(1, display.m_requestId, true, QStringLiteral("available"));
+        start(client, 1);
+        password(client, QStringLiteral("root"));
+        QTRY_VERIFY_WITH_TIMEOUT(display.m_waitingForLoser, 3500);
+        auto at = [&](const QString &name, const QString &role = {}) {
+            for (const auto &event : events)
+                if (event.first.contains(QStringLiteral("event=") + name + QLatin1Char(' '))
+                    && event.first.contains(QStringLiteral("request=") + display.m_requestId + QLatin1Char(' '))
+                    && (role.isEmpty() || event.first.contains(QStringLiteral(" role=") + role))) return event.second;
+            return qint64(-1);
+        };
+        const qint64 armed = at(QStringLiteral("deadline-armed"));
+        const qint64 selected = at(QStringLiteral("winner-selected"));
+        QVERIFY(armed > 0 && selected > armed && selected < armed + 4000);
+        const auto passwordStarted = std::find_if(events.cbegin(), events.cend(), [&](const auto &event) {
+            return event.first.contains(QStringLiteral("event=helper-start "))
+                && event.first.contains(QStringLiteral("request=") + display.m_requestId + QLatin1Char(' '))
+                && event.first.contains(QStringLiteral(" method=0 role=password"));
+        });
+        QVERIFY(passwordStarted != events.cend());
+        const auto passwordIdentity = QRegularExpression(QStringLiteral("helper_pid=(\\d+) auth_id=(\\d+) generation=(\\d+)"))
+                                          .match(passwordStarted->first);
+        QVERIFY(passwordIdentity.hasMatch() && passwordIdentity.captured(3) == QStringLiteral("1"));
+        auto passwordEvent = [&](const QString &name) {
+            for (const auto &event : events)
+                if (event.first.contains(QStringLiteral("event=") + name + QLatin1Char(' '))
+                    && event.first.contains(QStringLiteral("request=") + display.m_requestId + QLatin1Char(' '))
+                    && event.first.contains(QStringLiteral("helper_pid=") + passwordIdentity.captured(1) + QLatin1Char(' '))
+                    && event.first.contains(QStringLiteral("auth_id=") + passwordIdentity.captured(2) + QLatin1Char(' '))
+                    && event.first.contains(QStringLiteral("generation=1 "))
+                    && event.first.contains(QStringLiteral(" role=password"))) return event.second;
+            return qint64(-1);
