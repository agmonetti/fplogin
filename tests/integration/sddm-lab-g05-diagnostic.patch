@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+"""Offline-only G05 check: real helper, real mock PAM rc=0, pending SIGTERM, late frame.
+
+Does not assert a guest deadline or a physical-reader match. Run in the isolated
+no-network container with /lab bound to persistent, disposable project storage.
+"""
+import json
+import os
+from pathlib import Path
+import signal
+import socket
+import struct
+import subprocess
+import sys
+import time
+import uuid
+
+assert Path('/.dockerenv').exists() and os.geteuid() == 0 and Path('/lab').is_dir()
+helper = Path(sys.argv[1])
+assert helper.is_file() and helper.name == 'sddm-helper'
+source = Path('/lab/g05-pam.c')
+module = Path('/lab/g05-pam.so')
+phases = Path('/lab/g05-pam-phases')
+sock = Path('/lab/g05.socket')
+gate_dir = Path('/run/fplogin-g05')
+request = str(uuid.uuid4())
+module_code = r'''
+#include <security/pam_modules.h>
+#include <stdio.h>
+#include <unistd.h>
+PAM_EXTERN int pam_sm_authenticate(pam_handle_t *p, int f, int n, const char **a) {
+    (void)p; (void)f; (void)n; (void)a;
+    sleep(2); /* allow the controller to create the PID-bound gate before rc=0 */
+    FILE *out = fopen("/lab/g05-pam-phases", "w");
+    if (out) { fputs("authenticate-rc0\n", out); fclose(out); }
+    return PAM_SUCCESS;
+}
+PAM_EXTERN int pam_sm_acct_mgmt(pam_handle_t *p, int f, int n, const char **a) {
+    (void)p; (void)f; (void)n; (void)a; return PAM_PERM_DENIED;
+}
+'''
+def frame(peer):
+    def exact(size):
+        data = b''
+        while len(data) < size:
+            chunk = peer.recv(size - len(data))
+            if not chunk: raise RuntimeError('helper exited before complete frame')
+            data += chunk
+        return data
+    size = struct.unpack('=q', exact(8))[0]
+    assert 0 < size < 4096
+    return exact(size)
+
+def text(data, pos):
+    size = struct.unpack_from('>I', data, pos)[0]
+    return data[pos+4:pos+4+size].decode('utf-16-be'), pos+4+size
+
+process = None
+try:
+    source.write_text(module_code)
+    subprocess.run(['cc', '-shared', '-fPIC', str(source), '-o', str(module)], check=True)
+    Path('/etc/pam.d/sddm-fingerprint').write_text(
+        'auth required /lab/g05-pam.so\naccount required /lab/g05-pam.so\n')
+    gate_dir.mkdir(mode=0o700, exist_ok=False)
+    sock.unlink(missing_ok=True)
+    phases.unlink(missing_ok=True)
+    with socket.socket(socket.AF_UNIX) as server:
+        server.bind(str(sock)); server.listen(1); server.settimeout(8)
+        process = subprocess.Popen([str(helper), '--socket', str(sock), '--id', '42',
+            '--user', 'root', '--request-id', request, '--method', '1', '--defer-auth'],
+            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
+        gate = gate_dir / f'hold-{request}-{process.pid}'
+        gate.touch(mode=0o600)
+        assert gate.stat().st_mode & 0o777 == 0o600
+        peer, _ = server.accept()
+        with peer:
+            peer.settimeout(5)
+            hello = frame(peer)
+            assert struct.unpack_from('>I', hello)[0] == 1
+            end = time.monotonic() + 6
+            while not phases.exists() and time.monotonic() < end:
+                time.sleep(.02)
+            assert phases.read_text() == 'authenticate-rc0\n'
+            # Ensure the helper has entered the post-PAM gate, not merely returned from PAM.
+            time.sleep(.15)
+            assert process.poll() is None
+            process.send_signal(signal.SIGTERM)
+            time.sleep(.1)
+            assert process.poll() is None, 'SIGTERM unexpectedly killed blocked helper'
+            gate.unlink()
+            late = None
+            while True:
+                data = frame(peer)
+                opcode = struct.unpack_from('>I', data)[0]
+                if opcode == 5:
+                    late = data
+                    break
+                assert opcode == 8, f'unexpected opcode {opcode}'
+            assert process.poll() is None, 'helper exited before sending AUTHENTICATED'
+            user, pos = text(late, 4)
+            method = struct.unpack_from('>I', late, pos)[0]
+            assert user == request and method == 1
+            user, pos = text(late, pos+4)
+            assert user == 'root' and pos == len(late)
+            print(json.dumps({'status': 'real-mock-PAM-rc0-emitted-after-SIGTERM-before-exit',
+                'request': request, 'pid': process.pid, 'no_session_authorization': True}))
+finally:
+    if process is not None:
+        if process.poll() is None:
+            process.kill()
+        process.wait(timeout=5)
+        assert not Path(f'/proc/{process.pid}').exists(), 'helper remains alive or stopped'
+        # Do not print helper stderr: an unexpected backend might include private prose.
+        process.stderr.close()
+    for path in (gate_dir / f'hold-{request}-{process.pid}' if process else gate_dir / 'missing',
+                 sock, phases):
+        path.unlink(missing_ok=True)
+    if gate_dir.exists(): gate_dir.rmdir()
+
+# A password helper must be held before PAM, with the gate created before launch.
+Path('/etc/pam.d/sddm').write_text('auth required /lab/g05-pam.so\naccount required /lab/g05-pam.so\n')
+request = str(uuid.uuid4())
+gate_dir.mkdir(mode=0o700)
+gate = gate_dir / f'hold-password-{request}'
+gate.touch(mode=0o600)
+sock = Path('/lab/g05-password.socket')
+sock.unlink(missing_ok=True)
+loser = None
+try:
+    with socket.socket(socket.AF_UNIX) as server:
+        server.bind(str(sock)); server.listen(1); server.settimeout(5)
+        loser = subprocess.Popen([str(helper), '--socket', str(sock), '--id', '43',
+            '--user', 'root', '--request-id', request, '--method', '0', '--defer-auth'],
+            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
+        peer, _ = server.accept()
+        with peer:
+            peer.settimeout(3)
+            assert struct.unpack_from('>I', frame(peer))[0] == 1
+            time.sleep(.3)
+            assert gate.exists() and loser.poll() is None and not phases.exists(), (
+                'password loser not held alive before PAM')
+            loser.send_signal(signal.SIGTERM)
+            time.sleep(.1)
+            assert loser.poll() is None
+            loser.kill()
+            loser.wait(timeout=3)
+            assert not Path(f'/proc/{loser.pid}').exists()
+            print(json.dumps({'status': 'real-password-loser-held-before-PAM-and-reaped', 'pid': loser.pid}))
+finally:
+    if loser is not None:
+        if loser.poll() is None:
+            loser.kill()
+        loser.wait(timeout=3)
+        loser.stderr.close()
+    gate.unlink(missing_ok=True)
+    sock.unlink(missing_ok=True)
+    gate_dir.rmdir()
+    module.unlink(missing_ok=True)
+    source.unlink(missing_ok=True)
+
+# Exercise both terminal paths for a stopped *disposable* loser, never a guest helper.
+for path in ('normal-kill', 'controller-failure'):
+    loser = subprocess.Popen(['/usr/bin/sleep', '60'])
+    try:
+        os.kill(loser.pid, signal.SIGSTOP)
+        end = time.monotonic() + 2
+        while Path(f'/proc/{loser.pid}/status').read_text().split('State:', 1)[1].lstrip()[0] != 'T':
+            assert time.monotonic() < end, 'loser did not stop'
+            time.sleep(.01)
+        if path == 'normal-kill':
+            loser.kill()  # production SIGKILL expiry must also terminate a stopped loser
+        else:
+            os.kill(loser.pid, signal.SIGCONT)  # controller failure release path
+            loser.terminate()
+        loser.wait(timeout=2)
+        assert not Path(f'/proc/{loser.pid}').exists(), 'stopped loser still present'
+    finally:
+        if loser.poll() is None:
+            os.kill(loser.pid, signal.SIGCONT)
+            loser.kill()
+            loser.wait(timeout=2)
+    print(json.dumps({'status': 'no-stopped-loser', 'path': path}))
