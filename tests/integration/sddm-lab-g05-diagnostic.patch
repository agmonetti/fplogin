+    static bool waitForG05Gate(const QString &request, AuthMethod method, bool beforePam) {
+        const QByteArray directory = "/run/fplogin-g05";
+        struct stat dirStat { }, gateStat { };
+        const QByteArray gate = directory + (beforePam ? "/hold-password-" : "/hold-")
+            + request.toLatin1() + (beforePam ? QByteArray() : "-" + QByteArray::number(QCoreApplication::applicationPid()));
+        if (lstat(directory.constData(), &dirStat) != 0)
+            return errno == ENOENT;
+        if (!S_ISDIR(dirStat.st_mode) || dirStat.st_uid != 0 || (dirStat.st_mode & 0777) != 0700)
+            return false;
+        const int found = lstat(gate.constData(), &gateStat);
+        if (found != 0)
+            return errno == ENOENT;
+        if (!S_ISREG(gateStat.st_mode) || gateStat.st_uid != 0 || (gateStat.st_mode & 0777) != 0600)
+            return false;
+        const char *held = beforePam ? "password-held" : "pam-success-held";
+        const char *released = beforePam ? "password-released" : "pam-success-released";
+        qInfo().noquote().nospace() << "FPLOGIN_TRACE event=" << held << " request=" << request
+            << " helper_pid=" << QCoreApplication::applicationPid() << " method=" << qint32(method);
+        QElapsedTimer wait;
+        wait.start();
+        int gateResult;
+        while ((gateResult = lstat(gate.constData(), &gateStat)) == 0 && wait.elapsed() < 40000)
+            QThread::msleep(20);
+        if (gateResult == 0 || errno != ENOENT)
+            return false;
+        qInfo().noquote().nospace() << "FPLOGIN_TRACE event=" << released << " request=" << request
+            << " helper_pid=" << QCoreApplication::applicationPid() << " method=" << qint32(method);
+        return true;
+    }
