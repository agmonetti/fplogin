+// Real non-root peer; only used by the disposable-container credential regression.
+#include <cstring>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+int main(int argc, char **argv) {
+    if (argc != 2 || ::setgid(65534) || ::setuid(65534))
+        return 2;
+    const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+        return 3;
+    sockaddr_un address {};
+    address.sun_family = AF_UNIX;
+    if (std::strlen(argv[1]) >= sizeof(address.sun_path))
+        return 4;
+    std::strcpy(address.sun_path, argv[1]);
+    if (::connect(fd, reinterpret_cast<sockaddr *>(&address), sizeof(address)))
+        return 5; // The fixture must reach peercred, not stop at filesystem permissions.
+    pollfd wait {fd, POLLIN | POLLHUP, 0};
+    if (::poll(&wait, 1, 2000) <= 0)
+        return 6;
+    char byte;
+    const auto count = ::read(fd, &byte, 1);
+    ::close(fd);
+    return count == 0 ? 0 : 7;
+}
