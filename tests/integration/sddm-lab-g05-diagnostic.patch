+            connect(control.get(), &DiagnosticControl::failed, this, [&] {
+                capturedAccepted = control->m_abortStartedAt;
+                control.reset();
+            });
+            supervisor.send(abort);
+            QTRY_VERIFY(control.get() == nullptr);
+            QVERIFY(capturedAccepted > 0);
+            QCOMPARE(authority->m_ceiling, capturedAccepted + DiagnosticAbort::AbortTimeoutMs);
+        }
+        else if (mode == QLatin1String("display-loss")) display.reset();
+        else if (mode == QLatin1String("supervisor-loss")) supervisor.socket.abort();
+        else supervisor.send(abort);
+        QTRY_VERIFY(authority->started());
+        if (mode == QLatin1String("late-exit")) {
+            // Deterministic expiry fault: original recorded clock, not wall/chat time.
+            authority->m_ceiling = AuthLaunchObservation::monotonicMs();
+            authority->evaluate();
+            const auto frozen = authority->result();
+            QCOMPARE(frozen.value(QStringLiteral("outcome")).toString(), QStringLiteral("unreaped"));
+            QCOMPARE(frozen.value(QStringLiteral("reason")).toString(), QStringLiteral("exit_timeout"));
+            auth->kill();
+            QTRY_COMPARE(observation->record().state, AuthLaunchRecord::Exited);
+            QCOMPARE(authority->result(), frozen);
+        }
+        QTRY_VERIFY_WITH_TIMEOUT(authority->terminal(), DiagnosticAbort::AbortTimeoutMs + 1000);
+        const auto result = authority->result();
+        if (mode != QLatin1String("late-exit"))
+            QCOMPARE(result.value(QStringLiteral("outcome")).toString(), QStringLiteral("exits_observed"));
+        const auto entries = result.value(QStringLiteral("launches")).toArray();
+        QCOMPARE(entries.size(), 1);
