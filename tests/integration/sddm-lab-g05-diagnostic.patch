+            }
+        }
+        Client client;
+        connectClient(display, client);
+        QTRY_COMPARE_WITH_TIMEOUT(control->state(), DiagnosticControl::State::Failed, DiagnosticControl::TimeoutMs + 1000);
+        fragments.stop();
+        select(client, 1, QStringLiteral("root"));
+        QTRY_COMPARE(client.socket.state(), QLocalSocket::UnconnectedState);
+        for (const auto &event : client.events)
+            QVERIFY(event.message != DaemonMessages::AuthenticationContext || event.accepted == 0);
+        QCOMPARE(display.m_auth->launchGeneration(), quint64(0));
+        QCOMPARE(display.m_fingerprintAuth->launchGeneration(), quint64(0));
+    }
