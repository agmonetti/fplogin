+namespace SDDM {
+namespace {
+constexpr int MaxFrame = 4096;
+constexpr char BootstrapLatch[] = "_sddm_g05_control_bootstrapped";
+QString uuid() { return QUuid::createUuid().toString(QUuid::WithoutBraces); }
+}
+
+DiagnosticAbort::DiagnosticAbort(const QJsonObject &binding, QObject *parent)
+    : QObject(parent), m_binding(binding) {
+    m_binding.remove(QStringLiteral("type"));
+    m_timer.setSingleShot(true);
+    connect(&m_timer, &QTimer::timeout, this, &DiagnosticAbort::evaluate);
+}
+
+void DiagnosticAbort::observe(AuthLaunchObservation *observation) {
+    if (!observation || m_observations.contains(observation)) return;
+    observation->retainEvidence();
+    const auto record = observation->record();
+    const auto generationKey = record.method == AuthMethod::Password
+        ? QStringLiteral("passwordGeneration") : QStringLiteral("fingerprintGeneration");
+    bool conflict = record.requestId != m_binding.value(QStringLiteral("request")).toString()
+        || record.user != m_binding.value(QStringLiteral("user")).toString()
+        || (record.method != AuthMethod::Password && record.method != AuthMethod::Fingerprint)
+        || QString::number(record.generation) != m_binding.value(generationKey).toString();
+    for (const auto &existing : m_observations)
+        conflict |= existing && existing->record().method == record.method;
+    if (conflict) {
+        m_identityError = true; // Retain local fault; never cancel the foreign generation.
+        begin(QStringLiteral("identity_error"));
+        return;
+    }
+    m_observations.append(observation);
+    connect(observation, &AuthLaunchObservation::changed, this, [this] { evaluate(); });
+    if (m_started) observation->cancelExact(record);
+    evaluate();
+}
+
+QJsonArray DiagnosticAbort::launches() const {
+    QJsonArray entries;
+    for (const auto method : {AuthMethod::Password, AuthMethod::Fingerprint}) {
+        for (const auto &observation : m_observations) {
+            if (!observation) continue;
+            const auto r = observation->record();
+            if (r.method != method) continue;
+            const QString state = r.state == AuthLaunchRecord::Starting ? QStringLiteral("starting")
+                : r.state == AuthLaunchRecord::Running ? QStringLiteral("running")
+                : r.state == AuthLaunchRecord::Exited ? QStringLiteral("exited") : QStringLiteral("failed_to_start");
+            entries.append(QJsonObject {{QStringLiteral("method"), int(r.method)},
+                {QStringLiteral("generation"), QString::number(r.generation)},
+                {QStringLiteral("authId"), QString::number(r.authId)},
+                {QStringLiteral("pid"), r.pid > 0 ? QJsonValue(QString::number(r.pid)) : QJsonValue()},
+                {QStringLiteral("state"), state},
+                {QStringLiteral("exitStatus"), r.state != AuthLaunchRecord::Exited ? QStringLiteral("none")
+                    : r.exitStatus == QProcess::NormalExit ? QStringLiteral("normal") : QStringLiteral("crash")},
+                {QStringLiteral("exitCode"), r.state == AuthLaunchRecord::Exited ? QJsonValue(QString::number(r.exitCode)) : QJsonValue()}});
+        }
+    }
+    return entries;
+}
+
+QJsonObject DiagnosticAbort::status(const QString &phase) const {
+    if (terminal()) return m_result;
+    auto object = m_binding;
+    object.insert(QStringLiteral("type"), QStringLiteral("ABORT_STATUS"));
+    object.insert(QStringLiteral("phase"), phase);
+    object.insert(QStringLiteral("outcome"), QStringLiteral("pending"));
+    object.insert(QStringLiteral("reason"), QStringLiteral("none"));
+    object.insert(QStringLiteral("launches"), launches());
+    return object;
+}
+
+void DiagnosticAbort::begin(const QString &reason, qint64 acceptedAt) {
+    if (terminal()) return;
+    if (reason != QLatin1String("requested") && m_fatal.isEmpty()) m_fatal = reason;
+    if (!m_started) {
+        m_started = true;
+        m_ceiling = (acceptedAt < 0 ? AuthLaunchObservation::monotonicMs() : acceptedAt) + AbortTimeoutMs;
+        m_timer.setTimerType(Qt::PreciseTimer);
+        m_timer.start(qMax(qint64(1), m_ceiling - AuthLaunchObservation::monotonicMs()));
+        m_cancelling = true;
+        // Start every exact cancellation before a callback can freeze a partial ledger.
+        for (const auto &observation : m_observations)
+            if (observation && !observation->cancelExact(observation->record())) {
+                m_identityError = true;
+                if (m_fatal.isEmpty()) m_fatal = QStringLiteral("identity_error");
+            }
+        m_cancelling = false;
+    }
+    evaluate();
+}
+
+void DiagnosticAbort::evaluate() {
+    if (!m_started || terminal() || m_cancelling) return;
+    bool all = true, failedLaunch = false, late = false;
+    for (const auto &observation : m_observations) {
+        if (!observation) { all = false; continue; }
+        const auto r = observation->record();
+        const bool ended = r.state == AuthLaunchRecord::Exited || r.state == AuthLaunchRecord::FailedToStart;
+        all &= ended;
+        failedLaunch |= r.state == AuthLaunchRecord::FailedToStart;
+        late |= ended && r.terminalEntryMs >= m_ceiling;
+    }
+    const bool expired = AuthLaunchObservation::monotonicMs() >= m_ceiling;
+    if (!all && !expired) {
+        m_timer.start(qMax(qint64(1), m_ceiling - AuthLaunchObservation::monotonicMs()));
+        emit updated();
+        return;
+    }
+    const bool unreaped = !all || late;
+    auto result = status(QStringLiteral("aborting"));
+    result.insert(QStringLiteral("phase"), unreaped || failedLaunch || !m_fatal.isEmpty() || m_identityError
+        ? QStringLiteral("failed") : QStringLiteral("aborted"));
+    result.insert(QStringLiteral("outcome"), unreaped ? QStringLiteral("unreaped")
+        : failedLaunch ? QStringLiteral("launch_failed")
+        : m_observations.isEmpty() ? QStringLiteral("no_helper_launched") : QStringLiteral("exits_observed"));
+    result.insert(QStringLiteral("reason"), unreaped ? QStringLiteral("exit_timeout")
+        : !m_fatal.isEmpty() ? m_fatal
+        : failedLaunch ? QStringLiteral("launch_error") : QStringLiteral("requested"));
+    m_result = result; // Value snapshot: subsequent actual exit evidence cannot rewrite it.
+    m_timer.stop();
+    emit updated();
+}
+
+DiagnosticControl::DiagnosticControl(QObject *parent) : QObject(parent) {
+    m_timer.setSingleShot(true);
+    connect(&m_timer, &QTimer::timeout, this, [this] { invalidate(QStringLiteral("phase_timeout"), true); });
+    m_flushTimer.setSingleShot(true);
+    connect(&m_flushTimer, &QTimer::timeout, this, [this] { closeTransport(true); });
+}
+
+DiagnosticControl *DiagnosticControl::forApplication() {
+    return QCoreApplication::instance()->findChild<DiagnosticControl *>(QString(), Qt::FindDirectChildrenOnly);
+}
+
+bool DiagnosticControl::enabledForApplication() {
+    return QCoreApplication::instance()->property(BootstrapLatch).toBool();
+}
+
+DiagnosticControl *DiagnosticControl::fromArguments(const QStringList &arguments, QObject *application) {
+    if (application != QCoreApplication::instance() || enabledForApplication())
+        qFatal("Duplicate or invalid diagnostic bootstrap");
+    const QString option = QStringLiteral("--g05-control-dir");
+    int index = -1, count = 0;
+    for (int i = 0; i < arguments.size(); ++i) {
+        if (arguments.at(i) == option || arguments.at(i).startsWith(option + QLatin1Char('='))) {
+            index = i;
+            ++count;
+        }
+    }
+    if (!count)
+        return nullptr;
+    application->setProperty(BootstrapLatch, true); // Irreversible for this daemon's lifetime.
+    auto *control = new DiagnosticControl(application);
+    if (count != 1 || arguments.at(index) != option || index + 1 >= arguments.size()
+        || !control->listen(arguments.at(index + 1)))
+        return control;
+    control->phase(State::WaitingSupervisor);
+    return control;
+}
+
+bool DiagnosticControl::listen(const QString &directory) {
+#ifndef SO_PEERCRED
+    Q_UNUSED(directory);
+    return false;
+#else
+    // Pin every component; neither symlinks nor non-root writable parents are trusted.
+    if (geteuid() != 0 || !directory.startsWith(QLatin1Char('/'))
+        || QDir::cleanPath(directory) != directory || directory == QLatin1String("/")
+        || QFile::encodeName(directory + QStringLiteral("/control.sock")).size() >= int(sizeof(sockaddr_un::sun_path)))
+        return false;
+    int fd = ::open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0)
+        return false;
+    const auto components = directory.mid(1).split(QLatin1Char('/'));
+    for (int i = 0; i < components.size(); ++i) {
+        const auto component = QFile::encodeName(components.at(i));
+        const int next = ::openat(fd, component.constData(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        ::close(fd);
+        if (next < 0)
+            return false;
+        fd = next;
+        struct stat st {};
+        if (::fstat(fd, &st) || st.st_uid != 0 || st.st_gid != 0
+            || (st.st_mode & 0022) || (i == components.size() - 1 && (st.st_mode & 07777) != 0700)) {
+            ::close(fd);
+            return false;
+        }
+    }
+    m_dirFd = fd;
+    struct stat st {};
+    if (::fstatat(fd, "control.sock", &st, AT_SYMLINK_NOFOLLOW) == 0 || errno != ENOENT)
+        return false;
+    QFile boot(QStringLiteral("/proc/sys/kernel/random/boot_id"));
+    if (!boot.open(QIODevice::ReadOnly))
+        return false;
+    m_boot = QString::fromLatin1(boot.read(64)).trimmed();
+    if (m_boot.size() != 36 || QUuid(m_boot).isNull())
+        return false;
+    m_epoch = uuid();
+    // Native listener: QLocalServer::close unlinks even a substituted pathname.
+    // Cleanup below removes only the inode we created in the pinned directory.
+    const int socketFd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (socketFd < 0)
+        return false;
+    sockaddr_un name {};
+    name.sun_family = AF_UNIX;
+    const auto pinnedPath = QStringLiteral("/proc/self/fd/%1/control.sock").arg(fd).toLatin1();
+    if (pinnedPath.size() >= int(sizeof(name.sun_path))) {
+        ::close(socketFd);
+        return false;
+    }
+    std::memcpy(name.sun_path, pinnedPath.constData(), pinnedPath.size() + 1);
+    if (::bind(socketFd, reinterpret_cast<sockaddr *>(&name), sizeof(name))) {
+        ::close(socketFd);
+        return false;
+    }
+    if (::fstatat(fd, "control.sock", &st, AT_SYMLINK_NOFOLLOW)) {
+        ::close(socketFd);
+        return false;
+    }
+    m_device = st.st_dev;
+    m_inode = st.st_ino;
+    if (::fchmodat(fd, "control.sock", 0600, 0) || !S_ISSOCK(st.st_mode)
+        || st.st_uid != 0 || st.st_gid != 0 || ::listen(socketFd, 4)) {
+        ::close(socketFd);
+        return false;
+    }
+    m_listenerFd = socketFd;
+    m_notifier = new QSocketNotifier(socketFd, QSocketNotifier::Read, this);
+    connect(m_notifier, &QSocketNotifier::activated, this, [this] { accept(); });
+    m_address = directory + QStringLiteral("/control.sock");
+    return true;
+#endif
+}
+
+DiagnosticControl::~DiagnosticControl() {
+    blockSignals(true);
+    if (m_abort) disconnect(m_abort, nullptr, this, nullptr);
+    if (m_supervisor) disconnect(m_supervisor, nullptr, this, nullptr);
+    m_state = State::Aborting;
+    if (m_display) m_display->failDiagnosticContext();
+    if (m_abort) m_abort->begin(m_fatalReason.isEmpty() ? QStringLiteral("transport_error") : m_fatalReason, m_abortStartedAt);
+    closeTransport();
+    if (m_notifier)
+        m_notifier->setEnabled(false);
+    if (m_listenerFd >= 0) {
+        ::close(m_listenerFd);
+        m_listenerFd = -1;
+    }
+    if (m_supervisor)
+        m_supervisor->abort();
+    if (m_dirFd >= 0) {
+        struct stat st {};
+        if (m_inode && !::fstatat(m_dirFd, "control.sock", &st, AT_SYMLINK_NOFOLLOW)
+            && quint64(st.st_dev) == m_device && quint64(st.st_ino) == m_inode && S_ISSOCK(st.st_mode))
+            ::unlinkat(m_dirFd, "control.sock", 0);
+        ::close(m_dirFd);
+    }
+}
+
+void DiagnosticControl::phase(State state) {
+    m_state = state;
+    m_timer.stop();
+    m_deadline = QDeadlineTimer(TimeoutMs, Qt::PreciseTimer);
+    if (state == State::WaitingSupervisor || state == State::WaitingContext || state == State::AwaitConfirm)
+        m_timer.start(TimeoutMs);
+}
+
+void DiagnosticControl::accept() {
+#ifdef SO_PEERCRED
+    // Bound work per event-loop turn, including unauthorized/extra connections.
+    for (int i = 0; i < 4; ++i) {
+        const int fd = ::accept4(m_listenerFd, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+        if (fd < 0) {
+            if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+                m_notifier->setEnabled(false);
+                fail();
+            }
+            return;
+        }
+        struct ucred credentials {};
+        socklen_t size = sizeof(credentials);
+        const bool authorized = !::getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credentials, &size)
+            && size == sizeof(credentials) && credentials.uid == 0;
+        if (!authorized || m_supervisor || m_state != State::WaitingSupervisor || m_deadline.hasExpired()) {
+            ::close(fd);
+            continue;
+        }
+        auto *socket = new QLocalSocket(this);
+        if (!socket->setSocketDescriptor(fd)) {
+            ::close(fd);
+            socket->deleteLater();
+            fail();
+            return;
+        }
+        m_supervisor = socket;
+        socket->setReadBufferSize(MaxFrame + 4);
+        connect(socket, &QLocalSocket::readyRead, this, &DiagnosticControl::read);
+        connect(socket, &QLocalSocket::disconnected, this, [this] {
+            if (!m_closing) invalidate(QStringLiteral("supervisor_lost"), true);
+        });
+        connect(socket, &QLocalSocket::errorOccurred, this, [this] {
+            if (!m_closing) invalidate(QStringLiteral("transport_error"), true);
+        });
+        connect(socket, &QLocalSocket::bytesWritten, this, [this] {
+            if (terminal() && m_supervisor && !m_supervisor->bytesToWrite()) closeTransport();
+        });
+        read();
+    }
+#endif
+}
+
+bool DiagnosticControl::send(const QJsonObject &object) {
+    const auto payload = QJsonDocument(object).toJson(QJsonDocument::Compact);
+    if (!m_supervisor || payload.isEmpty() || payload.size() > MaxFrame
+        || m_supervisor->bytesToWrite() + payload.size() + 4 > MaxFrame + 4) {
+        invalidate(QStringLiteral("transport_error"), true);
+        return false;
+    }
+    QByteArray frame;
+    QDataStream out(&frame, QIODevice::WriteOnly);
+    out << quint32(payload.size());
+    frame.append(payload);
+    QPointer<DiagnosticControl> alive(this);
+    const auto written = m_supervisor->write(frame);
+    if (!alive) return false;
+    if (written != frame.size()) {
+        invalidate(QStringLiteral("transport_error"), true);
+        return false;
+    }
+    return true;
+}
+
+void DiagnosticControl::read() {
+    QPointer<DiagnosticControl> alive(this);
+    if (!m_supervisor || m_closing)
+        return;
+    m_input.append(m_supervisor->read(MaxFrame + 4 - m_input.size()));
+    while (m_input.size() >= 4) {
+        quint32 length = 0;
+        QDataStream header(m_input.left(4));
+        header >> length;
+        if (!length || length > MaxFrame) { fail(); return; }
+        if (m_input.size() < length + 4) {
+            if (m_supervisor->bytesAvailable())
+                QTimer::singleShot(0, this, &DiagnosticControl::read);
+            return;
+        }
+        const auto payload = m_input.mid(4, length);
+        m_input.remove(0, length + 4);
+        QJsonParseError error;
+        const auto document = QJsonDocument::fromJson(payload, &error);
+        // Canonical encoding also rejects duplicate keys and alternative spellings.
+        if (error.error != QJsonParseError::NoError || !document.isObject()
+            || document.toJson(QJsonDocument::Compact) != payload) { fail(); return; }
+        process(document.object());
+        if (!alive || m_closing)
+            return;
+    }
+    if (m_supervisor->bytesAvailable())
+        QTimer::singleShot(0, this, &DiagnosticControl::read);
+}
+
+void DiagnosticControl::process(const QJsonObject &object) {
+    if (terminal() && m_flushDeadline.hasExpired()) { closeTransport(); return; }
+    if ((m_state == State::WaitingSupervisor || m_state == State::WaitingContext || m_state == State::AwaitConfirm)
+        && m_deadline.hasExpired()) { invalidate(QStringLiteral("phase_timeout"), true); return; }
+    if (m_state == State::WaitingSupervisor) {
+        const QJsonObject hello {{QStringLiteral("version"), 1}, {QStringLiteral("type"), QStringLiteral("HELLO")},
+                                 {QStringLiteral("boot"), m_boot}};
+        if (object != hello) { fail(); return; }
+        phase(State::WaitingContext);
+        send({{QStringLiteral("version"), 1}, {QStringLiteral("type"), QStringLiteral("BOUND")},
+              {QStringLiteral("boot"), m_boot}, {QStringLiteral("epoch"), m_epoch}});
+        return;
+    }
+    auto bound = m_binding;
+    const auto type = object.value(QStringLiteral("type")).toString();
+    bound.insert(QStringLiteral("type"), type);
+    if (m_abort && (type == QLatin1String("ABORT") || type == QLatin1String("STATUS")) && object == bound) {
+        if (type == QLatin1String("ABORT") && !m_abort->started())
+            invalidate(QStringLiteral("requested"), false);
+        else
+            report();
+        return;
+    }
+    auto confirm = m_binding;
+    confirm.insert(QStringLiteral("type"), QStringLiteral("CONFIRM"));
+    if (m_state != State::AwaitConfirm || object != confirm || !m_display || !m_greeter) {
+        fail();
+        return;
+    }
+    phase(State::ReservedConfirmed);
+    m_display->stageAuthenticationContext(m_greeter, m_display->m_diagnosticSerial, true,
+                                         m_display->m_diagnosticUser, m_display->m_diagnosticSession);
+}
+
+void DiagnosticControl::attach(Display *display) {
+    if (m_attached) { fail(); return; }
+    m_attached = true;
+    m_display = display;
+    connect(display, &QObject::destroyed, this, [this, display] { displayLost(display); });
+}
+
+void DiagnosticControl::reject(QLocalSocket *socket, quint64 serial) {
+    QPointer<QLocalSocket> peer(socket);
+    if (!socket)
+        return;
+    if (m_display)
+        m_display->m_socketServer->authenticationContext(socket, serial, 0, QString(), QString(), Session(),
+            quint32(AuthenticationAvailability::Unavailable), quint32(AuthenticationPhase::Idle),
+            QStringLiteral("diagnostic_control_failed"));
+    if (peer) peer->disconnectFromServer();
+}
+
+void DiagnosticControl::reserve(Display *display, QLocalSocket *socket, quint64 serial, bool hasContext,
+                                const QString &user, const Session &session) {
+    if (m_display != display || m_state != State::WaitingContext || m_deadline.hasExpired()
+        || !hasContext || !m_supervisor || !display->reserveDiagnosticContext(socket, serial, user, session)) {
+        QPointer<DiagnosticControl> alive(this);
+        fail();
+        if (alive) reject(socket, serial);
+        return;
+    }
+    m_greeter = socket;
+    m_binding = {{QStringLiteral("version"), 1}, {QStringLiteral("type"), QStringLiteral("RESERVED")},
+                 {QStringLiteral("boot"), m_boot}, {QStringLiteral("epoch"), m_epoch},
+                 {QStringLiteral("transaction"), uuid()}, {QStringLiteral("socketId"), uuid()},
+                 {QStringLiteral("serial"), QString::number(serial)},
+                 {QStringLiteral("request"), display->m_diagnosticRequest}, {QStringLiteral("user"), user},
+                 {QStringLiteral("sessionType"), int(session.type())}, {QStringLiteral("sessionFile"), session.fileName()},
+                 {QStringLiteral("passwordGeneration"), QString::number(display->m_auth->launchGeneration() + 1)},
+                 {QStringLiteral("fingerprintGeneration"), QString::number(display->m_fingerprintAuth->launchGeneration() + 1)}};
+    // This authority and its exact launch records survive control/Display destruction.
+    m_abort = new DiagnosticAbort(m_binding, QCoreApplication::instance());
+    for (Auth *auth : {display->m_auth, display->m_fingerprintAuth}) {
+        connect(auth, &Auth::launchRecorded, m_abort, &DiagnosticAbort::observe);
+    }
+    connect(m_abort, &DiagnosticAbort::updated, this, &DiagnosticControl::report);
+    phase(State::AwaitConfirm);
+    send(m_binding);
+}
+
+bool DiagnosticControl::confirmedFor(Display *display, QLocalSocket *socket, quint64 serial) const {
+    return m_state == State::ReservedConfirmed && display == m_display && socket && socket == m_greeter
+        && QString::number(serial) == m_binding.value(QStringLiteral("serial")).toString();
+}
+
+void DiagnosticControl::greeterDisconnected(QLocalSocket *socket) {
+    if (socket == m_greeter && !m_invalidating)
+        invalidate(QStringLiteral("greeter_lost"), true);
+}
+
+void DiagnosticControl::displayLost(Display *display) {
+    if (display != m_display) return;
+    // Detach while Display's members still exist, not from QObject base destruction.
+    disconnect(this, nullptr, display, nullptr);
+    m_display.clear();
+    invalidate(QStringLiteral("display_lost"), true);
+}
+
+void DiagnosticControl::closeTransport(bool force) {
+    m_closing = true;
+    m_input.clear();
+    if (m_supervisor) {
+        if (!force && !m_flushDeadline.hasExpired() && m_supervisor->bytesToWrite() > 0)
+            m_supervisor->disconnectFromServer();
+        else
+            m_supervisor->abort();
+    }
+}
+
+void DiagnosticControl::report() {
+    QPointer<DiagnosticControl> alive(this);
+    if (!m_abort || m_reporting || m_invalidating) return;
+    if (m_abort->started() && m_state != State::Aborting && !terminal()) {
+        invalidate(QStringLiteral("identity_error"), false);
+        return;
+    }
+    m_reporting = true;
+    if (m_abort->terminal() && !terminal()) {
+        const auto result = m_abort->result();
+        m_state = result.value(QStringLiteral("phase")) == QLatin1String("aborted") ? State::Aborted : State::Failed;
+        m_flushDeadline = QDeadlineTimer(ResultFlushMs, Qt::PreciseTimer);
+        m_flushTimer.start(ResultFlushMs);
+    }
+    if (!m_closing) {
+        const QString phaseName = m_state == State::AwaitConfirm ? QStringLiteral("await_confirm")
+            : m_state == State::ReservedConfirmed ? QStringLiteral("reserved_confirmed") : QStringLiteral("aborting");
+        send(m_abort->status(phaseName));
+    }
+    if (alive) m_reporting = false;
+}
+
+void DiagnosticControl::invalidate(const QString &reason, bool closePeer) {
+    if (terminal()) { if (closePeer) closeTransport(); return; }
+    if (reason != QLatin1String("requested") && m_fatalReason.isEmpty()) m_fatalReason = reason;
+    m_pendingClose |= closePeer;
+    if (m_abortStartedAt < 0) m_abortStartedAt = AuthLaunchObservation::monotonicMs();
+    if (m_invalidating) return;
+    QPointer<DiagnosticControl> alive(this);
+    m_invalidating = true;
+    m_timer.stop();
+    m_state = State::Aborting; // Eligibility is invalid before callbacks, drain or cancellation.
+    emit failed();
+    if (!alive) return;
+    reject(m_greeter, m_binding.value(QStringLiteral("serial")).toString().toULongLong());
+    if (!alive) return;
+    m_greeter.clear();
+    if (m_abort) m_abort->begin(m_fatalReason.isEmpty() ? reason : m_fatalReason, m_abortStartedAt);
+    else m_state = State::Failed;
+    if (!alive) return;
+    m_invalidating = false;
+    report();
+    if (!alive) return;
+    if (m_pendingClose) closeTransport();
+}
+
+void DiagnosticControl::fail() {
+    invalidate(QStringLiteral("protocol_error"), true);
+}
+}
