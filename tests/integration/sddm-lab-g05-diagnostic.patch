+// Diagnostic-only pre-ACK reservation. Confirmation never permits a helper launch.
+#ifndef SDDM_DIAGNOSTICCONTROL_H
+#define SDDM_DIAGNOSTICCONTROL_H
+
+#include <QObject>
+#include <QPointer>
+#include <QJsonObject>
+#include <QTimer>
+#include <QDeadlineTimer>
+#include "Session.h"
+#include "Auth.h"
+#include <QJsonArray>
+
+class QLocalSocket;
+class QSocketNotifier;
+namespace SDDM {
+class Display;
+// Separate application-owned authority: transport/Display destruction cannot erase cleanup.
+class DiagnosticAbort final : public QObject {
+    Q_OBJECT
+public:
+    static constexpr int AbortTimeoutMs = 8000;
+    explicit DiagnosticAbort(const QJsonObject &binding, QObject *parent);
+    void observe(AuthLaunchObservation *observation);
+    void begin(const QString &reason, qint64 acceptedAt = -1);
+    QJsonObject status(const QString &phase) const;
+    bool active() const { return m_started && m_result.isEmpty(); }
+    bool terminal() const { return !m_result.isEmpty(); }
+    bool started() const { return m_started; }
+    QJsonObject result() const { return m_result; }
+signals:
+    void updated();
+private:
+    friend class DaemonContextTest;
+    void evaluate();
+    QJsonArray launches() const;
+    QJsonObject m_binding, m_result;
+    QList<QPointer<AuthLaunchObservation>> m_observations;
+    QString m_fatal;
+    bool m_started = false, m_identityError = false, m_cancelling = false;
+    qint64 m_ceiling = 0;
+    QTimer m_timer;
+};
+class DiagnosticControl final : public QObject {
+    Q_OBJECT
+public:
+    enum class State { WaitingSupervisor, WaitingContext, AwaitConfirm, ReservedConfirmed, Aborting, Aborted, Failed };
+    static constexpr int ResultFlushMs = 1000;
+    static constexpr int TimeoutMs = 3000;
+    // Null means no option; an invalid opt-in returns Failed, never disabled.
+    static DiagnosticControl *fromArguments(const QStringList &arguments, QObject *application);
+    static DiagnosticControl *forApplication();
+    static bool enabledForApplication();
+    ~DiagnosticControl() override;
+    State state() const { return m_state; }
+    QString address() const { return m_address; }
+    void attach(Display *display);
+    void reserve(Display *display, QLocalSocket *socket, quint64 serial, bool hasContext,
+                 const QString &user, const Session &session);
+    bool confirmedFor(Display *display, QLocalSocket *socket, quint64 serial) const;
+    void greeterDisconnected(QLocalSocket *socket);
+    void displayLost(Display *display);
+    void fail();
+
+signals:
+    void failed();
+
+private:
+    explicit DiagnosticControl(QObject *parent);
+    bool listen(const QString &directory);
+    void accept();
+    void read();
+    void process(const QJsonObject &object);
+    bool send(const QJsonObject &object);
+    void phase(State state);
+    void reject(QLocalSocket *socket, quint64 serial);
+    void invalidate(const QString &reason, bool closeTransport);
+    void closeTransport(bool force = false);
+    void report();
+    bool terminal() const { return m_state == State::Aborted || m_state == State::Failed; }
+    DiagnosticAbort *m_abort = nullptr;
+    QTimer m_flushTimer;
+    QDeadlineTimer m_flushDeadline;
+    QString m_fatalReason;
+    qint64 m_abortStartedAt = -1;
+    bool m_pendingClose = false;
+    bool m_invalidating = false, m_closing = false, m_reporting = false;
+    friend class DaemonContextTest;
+
+    State m_state = State::Failed;
+    int m_listenerFd = -1;
+    QSocketNotifier *m_notifier = nullptr;
+    QTimer m_timer;
+    QDeadlineTimer m_deadline;
+    QPointer<QLocalSocket> m_supervisor;
+    QPointer<QLocalSocket> m_greeter;
+    QPointer<Display> m_display;
+    bool m_attached = false;
+    QByteArray m_input;
+    QString m_address, m_boot, m_epoch;
+    QJsonObject m_binding;
+    int m_dirFd = -1;
+    quint64 m_device = 0, m_inode = 0;
+};
+}
+#endif
