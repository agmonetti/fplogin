+    struct Supervisor {
+        QLocalSocket socket;
+        QByteArray pending;
+        QList<QJsonObject> messages;
+        Supervisor() {
+            QObject::connect(&socket, &QLocalSocket::readyRead, &socket, [this] {
+                pending.append(socket.readAll());
+                while (pending.size() >= 4) {
+                    quint32 length = 0;
+                    QDataStream header(pending.left(4));
+                    header >> length;
+                    if (!length || length > 4096 || pending.size() < length + 4)
+                        return;
+                    messages.append(QJsonDocument::fromJson(pending.mid(4, length)).object());
+                    pending.remove(0, length + 4);
+                }
+            });
+        }
+        static QByteArray frame(const QJsonObject &object) {
+            const auto payload = QJsonDocument(object).toJson(QJsonDocument::Compact);
+            QByteArray bytes;
+            QDataStream output(&bytes, QIODevice::WriteOnly);
+            output << quint32(payload.size());
+            return bytes + payload;
+        }
+        void send(const QJsonObject &object) { socket.write(frame(object)); socket.flush(); }
+    };
