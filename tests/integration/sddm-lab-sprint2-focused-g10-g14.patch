+        // Mock PAM log line "<what> pid=<pid> ms=<ms> rc=<rc>" -> ms, or -1.
+        static qint64 pam(const QString &what, const QString &pid, int rc = -1000) {
+            QFile file(QStringLiteral("/lab/sprint2-pam-log"));
+            if (!file.open(QIODevice::ReadOnly))
+                return -1;
+            const auto pattern = QRegularExpression(QStringLiteral("^(\\S+) pid=(\\d+) ms=(\\d+) rc=(-?\\d+)$"));
+            for (const auto &raw : QString::fromUtf8(file.readAll()).split(QLatin1Char('\n'))) {
