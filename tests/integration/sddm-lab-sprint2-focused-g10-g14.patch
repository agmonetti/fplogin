+    // G10 offline: genuine fingerprint PAM success followed by pam_acct_mgmt
+    // PAM_PERM_DENIED in the real helper. Proves daemon-side outcome only:
+    // matched is published, the attempt finishes Failed, no session opens.
+    // G14 offline: a power request during an active attempt cancels both
+    // helpers, dispatches only after both exits are observed, exactly once,
+    // and never relaunches fingerprint without a fresh visible context.
+    void powerWaitsForObservedHelperExitsAndNeverResumesHidden() {
+        Harness display(directory->filePath(QStringLiteral("control")));
+        Client client;
+        activate(display, client, QStringLiteral("a"));
+        password(client, QStringLiteral("a"));
+        QTRY_VERIFY(display.peers.contains(int(AuthMethod::Password)));
+        const auto fingerprintGeneration = display.m_fingerprintAuth->launchGeneration();
+        const auto passwordGeneration = display.m_auth->launchGeneration();
+        QVERIFY(display.m_fingerprintAuth->isActive() && display.m_auth->isActive());
+        display.requestPower(GreeterMessages::Suspend);
+        display.requestPower(GreeterMessages::PowerOff);
+        QTest::qWait(200);
+        QVERIFY(display.powerDispatches.isEmpty());
+        display.command(AuthMethod::Fingerprint, "E");
+        QTRY_VERIFY(!display.m_fingerprintAuth->isActive());
+        QTest::qWait(100);
+        QVERIFY2(display.powerDispatches.isEmpty(), "dispatched before the password helper exited");
+        const auto passwordExit = QDateTime::currentMSecsSinceEpoch();
+        display.command(AuthMethod::Password, "E");
+        QTRY_VERIFY(!display.m_auth->isActive());
+        QTRY_COMPARE(display.powerDispatches.size(), 1);
+        QCOMPARE(display.powerDispatches.first().first, GreeterMessages::Suspend);
+        QVERIFY(display.powerDispatches.first().second >= passwordExit);
+        QVERIFY(!client.state(FingerprintState::Matched));
+        QVERIFY(!display.m_contextCommitted);
+        // Simulated resume: availability arriving for the old request must not relaunch.
+        display.setFingerprintAvailability(1, display.m_requestId, true, QStringLiteral("available"));
+        QTest::qWait(1200);
+        QCOMPARE(display.powerDispatches.size(), 1);
+        QCOMPARE(display.m_fingerprintAuth->launchGeneration(), fingerprintGeneration);
+        QCOMPARE(display.m_auth->launchGeneration(), passwordGeneration);
+        QVERIFY(!display.m_fingerprintAuth->isActive() && !display.m_auth->isActive());
+        QVERIFY(!display.m_contextOptedIn);
+        // A fresh visible context after resume may start the reader again.
+        Client fresh;
+        connectClient(display, fresh);
+        select(fresh, 2, QStringLiteral("a"));
+        QTRY_COMPARE(display.m_contextUser, QStringLiteral("a"));
+        display.setFingerprintAvailability(2, display.m_requestId, true, QStringLiteral("available"));
+        start(fresh, 2);
+        QTRY_VERIFY(display.m_fingerprintStartRequested);
+        display.setFingerprintAvailability(2, display.m_requestId, true, QStringLiteral("available"));
+        QTRY_COMPARE(display.m_fingerprintAuth->launchGeneration(), fingerprintGeneration + 1);
+        QTRY_COMPARE(display.peers.value(int(AuthMethod::Fingerprint)).request, display.m_requestId);
+        display.command(AuthMethod::Fingerprint, "E");
+        QTRY_VERIFY(!display.m_fingerprintAuth->isActive());
+    }
+    void realPamAccountDeniedAfterFingerprintMatch() {
+#ifndef G05_INTEGRATED
+        QSKIP("Requires disposable-container PAM and real helper");
+#else
+        QVERIFY(QFile::exists(QStringLiteral("/.dockerenv")));
+        QVERIFY(QFile::exists(QStringLiteral("/lab/g05-pam.so")));
+        QVERIFY(QFile::exists(QStringLiteral("/lab/g10-account-deny")));
+        mainConfig.FingerprintAuthTimeout.set(30);
+        static QList<QPair<QString, qint64>> events;
+        events.clear();
+        const auto previous = qInstallMessageHandler([](QtMsgType, const QMessageLogContext &, const QString &message) {
+            if (message.contains(QStringLiteral("FPLOGIN_TRACE")))
+                events.append({message, AuthLaunchObservation::monotonicMs()});
+        });
+        struct Restore {
+            QtMessageHandler previous;
+            ~Restore() { qInstallMessageHandler(previous); }
+        } restore { previous };
+        Harness display(directory->filePath(QStringLiteral("control")));
+        // A wrongly opened session would execute the fixture script and leave a record.
+        display.realTestSession = true;
+        Client client;
+        connectClient(display, client);
+        select(client, 1, QStringLiteral("root"));
+        QTRY_COMPARE(display.m_contextUser, QStringLiteral("root"));
+        display.setFingerprintAvailability(1, display.m_requestId, true, QStringLiteral("available"));
+        start(client, 1);
+        QTRY_COMPARE_WITH_TIMEOUT(client.count(DaemonMessages::AuthenticationAttemptFinished), 1, 10000);
+        QTRY_VERIFY_WITH_TIMEOUT(!display.m_fingerprintAuth->isActive(), 8000);
+        auto at = [&](const QString &name) {
+            for (const auto &event : events)
+                if (event.first.contains(QStringLiteral("event=") + name + QLatin1Char(' '))
+                    && event.first.contains(QStringLiteral("request=") + display.m_requestId + QLatin1Char(' ')))
+                    return event.second;
+            return qint64(-1);
+        };
+        const qint64 selected = at(QStringLiteral("winner-selected"));
+        const qint64 exited = at(QStringLiteral("helper-exit"));
+        QString exitResult;
+        for (const auto &event : events)
+            if (event.first.contains(QStringLiteral("event=helper-exit-result request=") + display.m_requestId + QLatin1Char(' ')))
+                exitResult = event.first;
+        const auto finished = std::find_if(client.events.cbegin(), client.events.cend(), [](const auto &event) {
+            return event.message == DaemonMessages::AuthenticationAttemptFinished;
+        });
+        QVERIFY(finished != client.events.cend());
+        fprintf(stderr, "G10 request=%s selected=%lld permit=%lld exited=%lld finished-result=%u finished-method=%u exit-result=%s\n",
+                qPrintable(display.m_requestId), static_cast<long long>(selected),
+                static_cast<long long>(at(QStringLiteral("authorization-permit"))), static_cast<long long>(exited),
+                finished->result, finished->method, qPrintable(exitResult));
+        QVERIFY(selected > 0);
+        QVERIFY(client.state(FingerprintState::Matched));
+        QCOMPARE(finished->result, quint32(AuthenticationResult::Failed));
+        QCOMPARE(finished->method, quint32(AuthenticationMethod::Fingerprint));
+        QCOMPARE(at(QStringLiteral("session-open-success")), qint64(-1));
+        QCOMPARE(at(QStringLiteral("kill-intent")), qint64(-1));
+        QVERIFY(!display.m_contextCommitted);
+        QVERIFY(!QFile::exists(QStringLiteral("/lab/g05-session-executions")));
+        QVERIFY(!QFile::exists(QStringLiteral("/lab/g05-session-pam")));
+        QCOMPARE(display.m_fingerprintAuth->launchGeneration(), quint64(1));
+        QTest::qWait(1500);
+        QCOMPARE(display.m_fingerprintAuth->launchGeneration(), quint64(1));
+        QCOMPARE(client.count(DaemonMessages::AuthenticationAttemptFinished), 1);
 #endif
