+#include <QSignalSpy>
+#include <QTemporaryDir>
+#include <QTest>
+#include <memory>
+
+using namespace SDDM;
+
+// Only user discovery is a fixture. Authentication and session identity use production code.
+class ThemeUsers : public QAbstractListModel {
+    Q_OBJECT
+    Q_PROPERTY(int count READ rowCount CONSTANT)
+    Q_PROPERTY(int lastIndex READ lastIndex CONSTANT)
+    Q_PROPERTY(QString lastUser READ lastUser CONSTANT)
+public:
+    int rowCount(const QModelIndex &parent = {}) const override { return parent.isValid() ? 0 : 2; }
+    int lastIndex() const { return 0; }
+    QString lastUser() const { return QStringLiteral("alice"); }
+    QHash<int, QByteArray> roleNames() const override { return {{Qt::UserRole, "name"}, {Qt::UserRole + 1, "realName"}}; }
+    QVariant data(const QModelIndex &index, int role) const override {
+        if (!index.isValid() || index.row() < 0 || index.row() >= 2) return {};
+        if (role == Qt::UserRole) return index.row() == 0 ? QStringLiteral("alice") : QStringLiteral("bob");
+        if (role == Qt::UserRole + 1) return index.row() == 0 ? QStringLiteral("Alice") : QStringLiteral("Bob");
+        return {};
+    }
+};
+
+class FploginThemeTest : public QObject {
+    Q_OBJECT
+    struct Frame {
+        GreeterMessages message;
+        quint64 serial = 0;
+        quint32 flag = 0;
+        QString user, password, request;
+        Session session;
+    };
+    QTemporaryDir temporary;
+    QLocalServer server;
+    std::unique_ptr<QLocalSocket> peer;
+    std::unique_ptr<SessionModel> sessions;
+    std::unique_ptr<GreeterProxy> proxy;
+    ThemeUsers users;
+    std::unique_ptr<QQuickView> view;
+    QList<Frame> frames;
+    quint64 serial = 0;
+    Session selected;
+    QString request = QStringLiteral("11111111-1111-4111-8111-111111111111");
+
+    void receive() {
+        QDataStream in(peer.get());
+        while (peer->bytesAvailable()) {
+            in.startTransaction();
+            quint32 opcode = 0;
+            in >> opcode;
+            Frame frame;
+            frame.message = GreeterMessages(opcode);
+            switch (frame.message) {
+            case GreeterMessages::Connect:
+            case GreeterMessages::QueryAuthenticationCapabilities: break;
+            case GreeterMessages::SetAuthenticationContext:
+                in >> frame.serial >> frame.flag;
+                if (frame.flag) in >> frame.user >> frame.session;
+                break;
+            case GreeterMessages::StartAuthenticationMethod: in >> frame.serial >> frame.flag; break;
+            case GreeterMessages::CancelAuthenticationMethod: in >> frame.serial >> frame.request >> frame.flag; break;
+            case GreeterMessages::Login: in >> frame.user >> frame.password >> frame.session; break;
+            default: break;
+            }
+            if (!in.commitTransaction()) return;
+            frames.append(frame);
+        }
+    }
+    template<class Writer> void send(Writer writer) {
+        QByteArray bytes;
+        QDataStream out(&bytes, QIODevice::WriteOnly);
+        writer(out);
+        peer->write(bytes);
+        peer->flush();
+    }
+    int count(GreeterMessages message) const {
+        int result = 0;
+        for (const auto &frame : frames) if (frame.message == message) ++result;
+        return result;
+    }
+    QQuickItem *password() const { return view->rootObject()->findChild<QQuickItem *>(QStringLiteral("passwordField")); }
+    void load(QQuickView &target, bool controller) {
+        target.rootContext()->setContextProperty(QStringLiteral("sddm"), proxy.get());
+        target.rootContext()->setContextProperty(QStringLiteral("sessionModel"), sessions.get());
+        target.rootContext()->setContextProperty(QStringLiteral("userModel"), &users);
+        target.rootContext()->setContextProperty(QStringLiteral("authenticationController"), controller);
+        target.setResizeMode(QQuickView::SizeRootObjectToView);
+        target.resize(960, 640);
+        target.setSource(QUrl::fromLocalFile(qEnvironmentVariable("FPL_THEME_DIR") + QStringLiteral("/Main.qml")));
+        target.show();
+    }
+    void setup(bool correlated = true) {
+        QVERIFY(temporary.isValid());
+        QFile file(temporary.filePath(QStringLiteral("desktop.desktop")));
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        file.write("[Desktop Entry]\nName=Desktop\nExec=/bin/true\nTryExec=/bin/true\nType=Application\n");
+        file.close();
+        mainConfig.X11.SessionDir.set({temporary.path()});
+        mainConfig.Wayland.SessionDir.set({temporary.path()});
