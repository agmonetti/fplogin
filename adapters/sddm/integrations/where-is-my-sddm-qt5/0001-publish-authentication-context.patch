+    onValidLoginSelectionChanged: publishAuthenticationContext()
+    onContextAvailableChanged: publishAuthenticationContext()
+    onContextSurfaceReadyChanged: publishAuthenticationContext()
+    onContextBusyChanged: publishAuthenticationContext()
+    onContextOwnerChanged: {
+        // GreeterApp owns controller transfer/clear; mirrors must never clear it.
+        if (!contextOwner) contextRequested = false;
+        else publishAuthenticationContext();
+    }
+    Component.onCompleted: {
+        contextComponentReady = true;
+        publishAuthenticationContext();
+    }
+    Connections {
+        target: root.contextSupported ? sddm : null
+        function onAuthenticationContextCleared(serial) { root.publishAuthenticationContext(); }
+    }
