diff --git a/src/greeter/ThemeAuthentication.cpp b/src/greeter/ThemeAuthentication.cpp
new file mode 100644
index 0000000..361415e
--- /dev/null
+++ b/src/greeter/ThemeAuthentication.cpp
@@ -0,0 +1,278 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "ThemeAuthentication.h"
+#include "GreeterProxy.h"
+#include "SessionModel.h"
+
+#include <QAbstractItemModel>
+#include <QEvent>
+#include <QQuickItem>
+#include <QQuickView>
+#include <QQuickWindow>
+#include <QTimer>
+#include <QVariantMap>
+
+namespace SDDM {
+ThemeAuthentication::ThemeAuthentication(GreeterProxy *proxy, QAbstractItemModel *users,
+                                       SessionModel *sessions, QObject *parent)
+    : QObject(parent), m_proxy(proxy), m_users(users), m_sessions(sessions) {
+    for (QAbstractItemModel *model : {users, static_cast<QAbstractItemModel *>(sessions)}) {
+        if (!model) continue;
+        connect(model, &QAbstractItemModel::modelAboutToBeReset, this, &ThemeAuthentication::modelChanging);
+        connect(model, &QAbstractItemModel::modelReset, this, &ThemeAuthentication::modelChanged);
+        connect(model, &QAbstractItemModel::rowsAboutToBeRemoved, this, &ThemeAuthentication::modelChanging);
+        connect(model, &QAbstractItemModel::rowsRemoved, this, &ThemeAuthentication::modelChanged);
+        connect(model, &QAbstractItemModel::rowsAboutToBeInserted, this, &ThemeAuthentication::modelChanging);
+        connect(model, &QAbstractItemModel::rowsInserted, this, &ThemeAuthentication::modelChanged);
+        connect(model, &QAbstractItemModel::layoutAboutToBeChanged, this, &ThemeAuthentication::modelChanging);
+        connect(model, &QAbstractItemModel::layoutChanged, this, &ThemeAuthentication::modelChanged);
+        connect(model, &QAbstractItemModel::dataChanged, this, [this] {
+            if (!m_modelChanges) modelChanged();
+        });
+        connect(model, &QObject::destroyed, this, [this] { modelChanged(); });
+    }
+    connect(proxy, &GreeterProxy::authenticationMethodsAvailableChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::authenticationControllerChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::authenticationUserChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::authenticationSessionIndexChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::fingerprintRequestIdChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::fingerprintAvailableChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::fingerprintStateChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::fingerprintDetailCodeChanged, this, [this](const QString &detail) {
+        // Observe both probe edges synchronously, even in one decoded socket batch.
+        if (m_startPending) {
+            if (detail == QLatin1String("checking")) m_probePending = true;
+            else if (m_probePending) {
+                m_startPending = false;
+                m_probePending = false;
+            }
+        }
+        schedule();
+    });
+    connect(proxy, &GreeterProxy::authenticationBusyChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::authenticationSubmissionAllowedChanged, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::authenticationContextCleared, this, [this] {
+        m_startPending = false;
+        m_probePending = false;
+        schedule();
+    });
+    connect(proxy, &GreeterProxy::authenticationFinished, this, &ThemeAuthentication::schedule);
+    connect(proxy, &GreeterProxy::authenticationContextRejected, this, [this] {
+        restoreCommitted();
+        schedule();
+    });
+}
+
+int ThemeAuthentication::findUser(const QString &user) const {
+    if (!m_users || user.isEmpty()) return -1;
+    const int role = m_users->roleNames().key(QByteArrayLiteral("name"), -1);
+    if (role < 0) return -1;
+    for (int row = 0; row < m_users->rowCount(); ++row)
+        if (m_users->data(m_users->index(row, 0), role).toString() == user) return row;
+    return -1;
+}
+
+int ThemeAuthentication::userIndex() const { return m_modelChanges ? -1 : findUser(m_user); }
+int ThemeAuthentication::sessionIndex() const {
+    return m_modelChanges || !m_sessions || m_user.isEmpty()
+        ? -1 : m_sessions->indexOfSession(m_type, m_file);
+}
+bool ThemeAuthentication::valid() const { return userIndex() >= 0 && sessionIndex() >= 0; }
+
+bool ThemeAuthentication::owns(QQuickWindow *window) const {
+    return window && window == m_controller && m_roots.contains(window)
+        && m_roots.value(window).root && m_roots.value(window).root->window() == window;
+}
+bool ThemeAuthentication::ready() const {
+    return owns(m_controller) && valid() && m_controller->isVisible()
+        && m_controller->visibility() != QWindow::Minimized && m_controller->isExposed()
+        && m_roots.value(m_controller).root->isVisible();
+}
+
+void ThemeAuthentication::setControllerView(QQuickView *view) {
+    if (m_controller == view) return;
+    m_controller = view;
+    m_controllerIdentity = view;
+    // GreeterApp owns the clear/drain barrier on controller transfers.
+    m_startPending = false;
+    m_probePending = false;
+    if (owns(view) && !m_initialized) {
+        const auto surface = m_roots.value(view);
+        select(view, surface.initialUser, surface.initialSession);
+    }
+    emit selectionChanged();
+    schedule();
+}
+
+void ThemeAuthentication::attach(QQuickWindow *window, QQuickItem *root,
+                                 const QString &user, int sessionIndex) {
+    if (!window || !root || root->window() != window) return;
+    if (m_roots.contains(window)) {
+        if (m_roots.value(window).root != root) return;
+    } else {
+        m_roots.insert(window, {root, user, sessionIndex});
+        window->installEventFilter(this);
+        connect(root, &QQuickItem::visibleChanged, this, [this, window] {
+            if (window == m_controller) invalidateSurface();
+        });
+        connect(root, &QObject::destroyed, this, [this, window] {
+            m_roots.remove(window);
+            if (window == m_controllerIdentity) invalidateSurface();
+        });
+        connect(window, &QObject::destroyed, this, [this, window] {
+            m_roots.remove(window);
+            if (window == m_controllerIdentity) {
+                m_controllerIdentity = nullptr;
+                invalidateSurface();
+            }
+            schedule();
+        });
+    }
+    if (owns(window) && !m_initialized) select(window, user, sessionIndex);
+    emit selectionChanged();
+    schedule();
+}
+
+void ThemeAuthentication::changeTarget(const QString &user, int type, const QString &file) {
+    if (m_user == user && m_type == type && m_file == file) return;
+    // Even coalesced A -> B -> A intent must drain the old acknowledged A.
+    if (m_proxy && !m_proxy->authenticationBusy() && !m_proxy->authenticationUser().isEmpty())
+        m_proxy->clearAuthenticationContext();
+    m_user = user;
+    m_type = type;
+    m_file = file;
+    m_consumed = false;
+    m_startPending = false;
+    m_probePending = false;
+    m_retryRequested = false;
+    emit identityChanged();
+    emit selectionChanged();
+}
+
+bool ThemeAuthentication::select(QQuickWindow *window, const QString &user, int index) {
+    if (!owns(window) || m_modelChanges || !m_proxy) return false;
+    if (m_proxy->authenticationBusy()) {
+        restoreCommitted();
+        emit selectionChanged();
+        return false;
+    }
+    m_initialized = true;
+    const auto identity = m_sessions ? m_sessions->sessionIdentity(index) : QVariantMap();
+    if (findUser(user) < 0 || identity.isEmpty()) {
+        changeTarget(QString(), 0, QString());
+        invalidateSurface();
+        return false;
+    }
+    changeTarget(user, identity.value(QStringLiteral("type")).toInt(),
+                 identity.value(QStringLiteral("file")).toString());
+    schedule();
+    return true;
+}
+
+void ThemeAuthentication::cancel(QQuickWindow *window) {
+    if (!owns(window) || !m_proxy || m_proxy->authenticationBusy()) return;
+    m_consumed = true;
+    m_retryRequested = false;
+    m_startPending = false;
+    m_probePending = false;
+    if (m_proxy->authenticationMethodsAvailable()) m_proxy->cancelFingerprint();
+}
+
+void ThemeAuthentication::retry(QQuickWindow *window) {
+    if (!owns(window) || !ready() || !m_proxy || !m_proxy->authenticationMethodsAvailable()
+        || m_proxy->authenticationBusy() || m_startPending || m_probePending
+        || m_proxy->fingerprintDetailCode() == QLatin1String("checking")
+        || m_proxy->fingerprintState() == QLatin1String("scanning")
+        || m_proxy->fingerprintState() == QLatin1String("matched")) return;
+    m_consumed = false;
+    m_retryRequested = true;
+    schedule();
+}
+
+void ThemeAuthentication::schedule() {
+    if (m_queued) return;
+    m_queued = true;
+    QTimer::singleShot(0, this, [this] {
+        m_queued = false;
+        reconcile();
+    });
+}
+
+void ThemeAuthentication::invalidateSurface() {
+    if (!m_proxy) return;
+    if (!ready() && !m_proxy->authenticationBusy() && !m_proxy->authenticationUser().isEmpty()) {
+        m_startPending = false;
+        m_probePending = false;
+        m_proxy->clearAuthenticationContext();
+    }
+    schedule();
+}
+
+bool ThemeAuthentication::eventFilter(QObject *object, QEvent *event) {
+    if (object == m_controller && (event->type() == QEvent::Expose || event->type() == QEvent::Hide
+        || event->type() == QEvent::Show || event->type() == QEvent::WindowStateChange)) {
+        if (event->type() == QEvent::Hide && m_proxy && !m_proxy->authenticationBusy()
+            && !m_proxy->authenticationUser().isEmpty()) {
+            m_startPending = false;
+            m_probePending = false;
+            m_proxy->clearAuthenticationContext();
+        } else invalidateSurface();
+    }
+    return QObject::eventFilter(object, event);
+}
+
+void ThemeAuthentication::modelChanging() {
+    ++m_modelChanges;
+    emit selectionChanged();
+    invalidateSurface();
+}
+
+void ThemeAuthentication::modelChanged() {
+    if (m_modelChanges) --m_modelChanges;
+    if (m_modelChanges) return;
+    if (!valid() && (!m_proxy || !m_proxy->authenticationBusy())) {
+        changeTarget(QString(), 0, QString());
+        invalidateSurface();
+    }
+    emit selectionChanged();
+    schedule();
+}
+
+void ThemeAuthentication::restoreCommitted() {
+    if (!m_proxy || !m_proxy->authenticationBusy() || !m_sessions) return;
+    const auto identity = m_sessions->sessionIdentity(m_proxy->authenticationSessionIndex());
+    if (identity.isEmpty() || m_proxy->authenticationUser().isEmpty()) return;
+    changeTarget(m_proxy->authenticationUser(), identity.value(QStringLiteral("type")).toInt(),
+                 identity.value(QStringLiteral("file")).toString());
+    m_consumed = true;
+}
+
+void ThemeAuthentication::reconcile() {
+    if (!m_proxy || !m_proxy->authenticationController() || !owns(m_controller)) return;
+    if (!ready()) {
+        if (!m_proxy->authenticationBusy() && !m_proxy->authenticationUser().isEmpty()) {
+            m_startPending = false;
+            m_probePending = false;
+            m_proxy->clearAuthenticationContext();
+        }
+        return;
+    }
+    if (!m_proxy->authenticationMethodsAvailable() || m_proxy->authenticationBusy()) return;
+    const int index = sessionIndex();
+    if (m_startPending && !m_probePending && (m_proxy->fingerprintState() != m_startState
+        || m_proxy->fingerprintRequestId() != m_startRequest)) m_startPending = false;
+    const bool same = m_proxy->authenticationUser() == m_user
+        && m_proxy->authenticationSessionIndex() == index;
+    // Explicit Retry may reopen a completed attempt. Ordinary notifications must not.
+    if (!same || m_proxy->fingerprintRequestId().isEmpty() || m_retryRequested)
+        m_proxy->setAuthenticationContext(m_user, index);
+    if (!m_proxy->authenticationSubmissionAllowed() || m_proxy->authenticationUser() != m_user
+        || m_proxy->authenticationSessionIndex() != index || m_proxy->fingerprintRequestId().isEmpty()) return;
+    if (m_consumed || (!m_proxy->fingerprintAvailable() && !m_retryRequested)) return;
+    m_consumed = true;
+    m_retryRequested = false;
+    m_startPending = true;
+    m_startState = m_proxy->fingerprintState();
+    m_startRequest = m_proxy->fingerprintRequestId();
+    m_proxy->startFingerprint(m_user, index);
+}
+}
diff --git a/src/greeter/ThemeAuthentication.h b/src/greeter/ThemeAuthentication.h
new file mode 100644
index 0000000..d2fce19
--- /dev/null
+++ b/src/greeter/ThemeAuthentication.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef SDDM_THEMEAUTHENTICATION_H
+#define SDDM_THEMEAUTHENTICATION_H
+
+#include <QObject>
+#include <QPointer>
+#include <QHash>
+#include <QString>
+
+class QAbstractItemModel;
+class QQuickItem;
+class QQuickView;
+class QQuickWindow;
+
+namespace SDDM {
+class GreeterProxy;
+class SessionModel;
+
+// Explicit theme cooperation; no password or privileged authentication state lives here.
+class ThemeAuthentication : public QObject {
+    Q_OBJECT
+    Q_PROPERTY(QString user READ user NOTIFY selectionChanged)
+    Q_PROPERTY(int userIndex READ userIndex NOTIFY selectionChanged)
+    Q_PROPERTY(int sessionIndex READ sessionIndex NOTIFY selectionChanged)
+    Q_PROPERTY(bool valid READ valid NOTIFY selectionChanged)
+public:
+    ThemeAuthentication(GreeterProxy *proxy, QAbstractItemModel *users,
+                        SessionModel *sessions, QObject *parent = nullptr);
+    QString user() const { return m_user; }
+    int userIndex() const;
+    int sessionIndex() const;
+    bool valid() const;
+    void setControllerView(QQuickView *view);
+    Q_INVOKABLE void attach(QQuickWindow *window, QQuickItem *root, const QString &user, int sessionIndex);
+    Q_INVOKABLE bool select(QQuickWindow *window, const QString &user, int sessionIndex);
+    Q_INVOKABLE void cancel(QQuickWindow *window);
+    Q_INVOKABLE void retry(QQuickWindow *window);
+signals:
+    void selectionChanged();
+    void identityChanged();
+protected:
+    bool eventFilter(QObject *object, QEvent *event) override;
+private:
+    bool owns(QQuickWindow *window) const;
+    bool ready() const;
+    void schedule();
+    void reconcile();
+    void invalidateSurface();
+    void changeTarget(const QString &user, int type, const QString &file);
+    void modelChanging();
+    void modelChanged();
+    void restoreCommitted();
+    int findUser(const QString &user) const;
+
+    QPointer<GreeterProxy> m_proxy;
+    QPointer<QAbstractItemModel> m_users;
+    QPointer<SessionModel> m_sessions;
+    QPointer<QQuickWindow> m_controller;
+    QQuickWindow *m_controllerIdentity = nullptr;
+    struct Surface {
+        QPointer<QQuickItem> root;
+        QString initialUser;
+        int initialSession = -1;
+    };
+    QHash<QQuickWindow *, Surface> m_roots;
+    QString m_user, m_file;
+    int m_type = 0;
+    int m_modelChanges = 0;
+    bool m_initialized = false;
+    bool m_consumed = false;
+    bool m_queued = false;
+    bool m_startPending = false;
+    bool m_probePending = false;
+    bool m_retryRequested = false;
+    QString m_startState, m_startRequest;
+};
+}
+#endif
